#!/usr/bin/env bash
# Generated by `aria-core hooks install` — do not edit by hand.
#
# Auto-summarizes a freshly merged branch as an ARIA observation. The
# helper computes the diff between ORIG_HEAD and HEAD and dispatches it
# through the same DiffAnalyzer heuristic used by post-commit.
set -u

SQUASH="${1:-0}"
if [ "$SQUASH" = "1" ]; then
  exit 0  # squash merges are handled by the post-commit hook
fi

if ! command -v aria-core >/dev/null 2>&1; then
  exit 0
fi

ORIG_REV=$(git rev-parse ORIG_HEAD 2>/dev/null || true)
NEW_REV=$(git rev-parse HEAD 2>/dev/null || true)
[ -z "$NEW_REV" ] && exit 0

if [ -n "$ORIG_REV" ]; then
  RANGE="$ORIG_REV..$NEW_REV"
  DIFF_STAT=$(git diff "$RANGE" --stat 2>/dev/null || true)
  SUMMARY=$(git log "$RANGE" --oneline 2>/dev/null || true)
else
  RANGE="$NEW_REV"
  DIFF_STAT=$(git show --stat HEAD 2>/dev/null || true)
  SUMMARY=$(git log -1 --oneline 2>/dev/null || true)
fi

aria-core hooks-helper post-merge \
  --range="$RANGE" \
  --summary="$SUMMARY" \
  --diff-stat="$DIFF_STAT" \
  --timeout=5 || true
exit 0
