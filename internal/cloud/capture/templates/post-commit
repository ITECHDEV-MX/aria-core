#!/usr/bin/env bash
# Generated by `aria-core hooks install` — do not edit by hand.
#
# Captures the just-completed commit as an ARIA observation. The actual
# decision (skip vs save) lives inside `aria-core hooks-helper post-commit`,
# which applies the DiffAnalyzer heuristic and respects a 5s timeout.
set -u

if ! command -v aria-core >/dev/null 2>&1; then
  exit 0
fi

COMMIT_HASH=$(git rev-parse HEAD 2>/dev/null || true)
[ -z "$COMMIT_HASH" ] && exit 0

COMMIT_MSG=$(git log -1 --format=%B 2>/dev/null || true)

# Diff stat against parent. First-commit safe: fall back to staged diff.
if git rev-parse HEAD~1 >/dev/null 2>&1; then
  DIFF_STAT=$(git diff HEAD~1 HEAD --stat 2>/dev/null || true)
else
  DIFF_STAT=$(git show --stat HEAD 2>/dev/null || true)
fi

aria-core hooks-helper post-commit \
  --commit="$COMMIT_HASH" \
  --message="$COMMIT_MSG" \
  --diff-stat="$DIFF_STAT" \
  --timeout=5 || true
exit 0
