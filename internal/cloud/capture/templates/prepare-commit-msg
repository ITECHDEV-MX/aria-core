#!/usr/bin/env bash
# Generated by `aria-core hooks install` — do not edit by hand.
#
# Suggests a conventional-commit title based on the staged diff. If the
# commit message file already contains user content, the hook leaves it
# untouched. Falls back silently if aria-core is not on PATH.
set -u

COMMIT_MSG_FILE="${1:-}"
COMMIT_SOURCE="${2:-}"
[ -z "$COMMIT_MSG_FILE" ] && exit 0

# Skip when the user is amending, merging, or already supplied a message.
case "$COMMIT_SOURCE" in
  message|template|merge|squash|commit) exit 0 ;;
esac

# Only act on empty/comment-only commit messages.
EXISTING=$(grep -v '^#' "$COMMIT_MSG_FILE" 2>/dev/null | tr -d '[:space:]' || true)
[ -n "$EXISTING" ] && exit 0

if ! command -v aria-core >/dev/null 2>&1; then
  exit 0
fi

DIFF=$(git diff --cached --stat 2>/dev/null || true)
[ -z "$DIFF" ] && exit 0

SUGGESTION=$(aria-core hooks-helper prepare-commit-msg --diff-stat="$DIFF" 2>/dev/null || true)
if [ -n "$SUGGESTION" ]; then
  TMP=$(mktemp 2>/dev/null || echo "$COMMIT_MSG_FILE.aria.tmp")
  printf '%s\n\n' "$SUGGESTION" >"$TMP"
  cat "$COMMIT_MSG_FILE" >>"$TMP"
  mv "$TMP" "$COMMIT_MSG_FILE"
fi
exit 0
