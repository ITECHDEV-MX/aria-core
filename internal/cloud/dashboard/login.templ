package dashboard

// LoginPage — split-screen con brand panel iTechDev + form. Identidad nueva.
templ LoginPage(errorMsg string, next string) {
	<!DOCTYPE html>
	<html lang="es" data-theme="dark">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Iniciar sesión — ARIA Core</title>
			<link rel="stylesheet" href="/dashboard/static/aria-styles.css"/>
		</head>
		<body>
			<main class="login-shell">
				<section class="login-sidepanel">
					<div>
						<img src="/dashboard/static/img/itechdev-logo-white.png" alt="iTechDev" style="height:42px;margin-bottom:1rem"/>
						<p class="section-kicker" style="color:rgba(255,255,255,0.85)">ARIA CORE</p>
						<h1>Memoria persistente para tu equipo y agentes IA</h1>
						<p class="login-lead">Plataforma central iTechDev: conocimiento curado, cotizaciones, skills y MCP server para Claude Desktop.</p>
					</div>
					<div class="login-console">
						<p><span class="console-key">cliente</span> Claude Desktop · Code · CLI · API REST</p>
						<p><span class="console-key">memoria</span> FTS español · scope multi-rol · canon</p>
						<p><span class="console-key">auth</span> JWT HS256 · bcrypt · 4 roles</p>
						<p><span class="console-key">stack</span> Go · Postgres · templ · HTMX</p>
					</div>
				</section>

				<section class="login-container">
					<div class="login-form">
						<p class="section-kicker">INICIAR SESIÓN</p>
						<h2>Bienvenido de nuevo</h2>
						<p class="login-copy">Accedé con tu correo y contraseña.</p>

						if errorMsg != "" {
							<div class="login-error" role="alert">{ errorMsg }</div>
						}

						<form method="post" action="/dashboard/login">
							if next != "" {
								<input type="hidden" name="next" value={ next }/>
							}
							<label>
								Correo electrónico
								<input
									type="email"
									name="email"
									placeholder="tu@itechdev.com.mx"
									required
									autocomplete="email"
									autofocus
								/>
							</label>
							<label>
								Contraseña
								<input
									type="password"
									name="password"
									placeholder="••••••••"
									required
									autocomplete="current-password"
								/>
							</label>
							<button type="submit" class="btn btn-primary btn-lg" style="width:100%">Iniciar sesión</button>
						</form>

						<p style="margin:0.75rem 0 0 0;text-align:center;font-size:0.85rem">
							<a href="/dashboard/forgot-password" style="color:var(--muted-foreground)">¿Olvidaste tu contraseña?</a>
						</p>

						<details class="login-recovery">
							<summary>Recuperación con token admin</summary>
							<form method="post" action="/dashboard/login" style="margin-top:0.75rem">
								if next != "" {
									<input type="hidden" name="next" value={ next }/>
								}
								<label>
									Token de recuperación
									<input
										type="password"
										name="token"
										placeholder="ARIA_CORE_CLOUD_ADMIN"
										autocomplete="off"
									/>
								</label>
								<button type="submit" class="btn btn-outline" style="width:100%">Acceder con token</button>
							</form>
						</details>

						<p style="margin-top:2rem;font-size:0.8rem;color:var(--muted-foreground)">
							© ITECHDEV MX, S.A. de C.V. · Monterrey, NL
						</p>
					</div>
				</section>
			</main>
		</body>
	</html>
}
