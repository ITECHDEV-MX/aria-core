package dashboard

import "fmt"

// KnowledgeBasePage es el shell admin del módulo wave 8. Muestra status
// agregado + filtros + tabla de entidades sincronizadas.
templ KnowledgeBasePage(degraded bool) {
	<div class="main-header">
		<div>
			<p class="section-kicker">WAVE 8 / KNOWLEDGE BASE</p>
			<h1>📚 Knowledge base sync</h1>
			<p class="lead">PRDs, historias y cotizaciones del equipo se sincronizan automáticamente al repo central <code>ITECHDEV-MX/team-knowledge-base</code>. Esta vista muestra el estado del tracking + permite re-sync manual.</p>
		</div>
	</div>
	if degraded {
		<div class="card" style="border-left:4px solid #d35;background:#fff8f8">
			<strong>Modo degradado:</strong> El servicio knowledge-base no tiene un cliente GitHub configurado. Sólo se mostrará tracking histórico; los re-syncs fallarán hasta que se inyecte un GitHub client al cloudserver.
		</div>
	}
	<div style="margin-top:1rem;display:flex;gap:0.5rem;flex-wrap:wrap">
		<form hx-post="/dashboard/knowledge-base/resync-failed"
			hx-target="#kb-content"
			hx-swap="innerHTML"
			hx-confirm="¿Re-sincear todas las entidades fallidas?">
			<button type="submit" class="shell-button" style="background:#d35;color:#fff">↻ Re-sync failed</button>
		</form>
		<form hx-post="/dashboard/knowledge-base/refresh-index"
			hx-target="#kb-content"
			hx-swap="innerHTML">
			<button type="submit" class="shell-button">🗂 Refresh root index</button>
		</form>
	</div>

	<div style="margin-top:1rem">
		<form id="kb-filters"
			hx-get="/dashboard/knowledge-base/list"
			hx-target="#kb-content"
			hx-swap="innerHTML"
			hx-trigger="change">
			<div style="display:grid;grid-template-columns:1fr 1fr 1fr 1fr;gap:0.5rem">
				<label style="margin:0">
					<span class="muted">Tipo</span>
					<select name="entity_type">
						<option value="">(todos)</option>
						<option value="prd">PRD</option>
						<option value="historia">Historia</option>
						<option value="cotizacion">Cotización</option>
						<option value="project_readme">Project README</option>
						<option value="root_index">Root index</option>
					</select>
				</label>
				<label style="margin:0">
					<span class="muted">Status</span>
					<select name="status">
						<option value="">(todos)</option>
						<option value="ok">ok</option>
						<option value="pending">pending</option>
						<option value="failed">failed</option>
						<option value="skipped">skipped</option>
					</select>
				</label>
				<label style="margin:0">
					<span class="muted">Project ID</span>
					<input type="text" name="project_id" placeholder="UUID opcional"/>
				</label>
				<label style="margin:0">
					<span class="muted">Limit</span>
					<input type="number" name="limit" value="100" min="1" max="500"/>
				</label>
			</div>
		</form>
	</div>

	<div id="kb-content"
		hx-get="/dashboard/knowledge-base/list"
		hx-trigger="load"
		hx-swap="innerHTML">
		<p class="muted" style="margin-top:1rem">Cargando entidades sincronizadas...</p>
	</div>
}

// KnowledgeBaseListPartial pinta la tabla del estado actual + status badges.
templ KnowledgeBaseListPartial(entries []KBSyncedEntityView, stats KBStatusView) {
	@KnowledgeBaseStatusBadge(stats)
	if len(entries) == 0 {
		@EmptyState("Sin sync activo", "Aún no se ha sincronizado ninguna entidad al repo central.")
	} else {
		<table class="data-table" style="margin-top:0.75rem">
			<thead>
				<tr>
					<th>Tipo</th>
					<th>Path en GitHub</th>
					<th>Project</th>
					<th>Status</th>
					<th>Último sync</th>
					<th>Acciones</th>
				</tr>
			</thead>
			<tbody>
				for _, e := range entries {
					<tr>
						<td><span class="badge badge-muted">{ e.EntityType }</span></td>
						<td>
							if e.GitHubURL != "" {
								<a href={ templ.SafeURL(e.GitHubURL) } target="_blank" rel="noopener"><code>{ e.RepoPath }</code></a>
							} else {
								<code>{ e.RepoPath }</code>
							}
							if e.EntityID != "" {
								<br/><small class="muted">{ e.EntityID }</small>
							}
						</td>
						<td>
							if e.ProjectID != "" {
								<small>{ e.ProjectID }</small>
							} else {
								<small class="muted">—</small>
							}
						</td>
						<td>
							@kbStatusBadge(e.SyncStatus)
							if e.LastError != "" {
								<br/><small style="color:#a22">{ truncateString(e.LastError, 80) }</small>
							}
						</td>
						<td><small>{ e.LastSyncedAt.Format("2006-01-02 15:04") }</small></td>
						<td>
							if e.EntityType == "cotizacion" && e.EntityID != "" {
								<form hx-post={ "/dashboard/knowledge-base/quotes/" + e.EntityID + "/sync" }
									hx-target="#kb-content"
									hx-swap="innerHTML"
									style="display:inline">
									<button type="submit" class="shell-button">↻ Re-sync</button>
								</form>
							}
							if e.ProjectID != "" {
								<form hx-post={ "/dashboard/knowledge-base/projects/" + e.ProjectID + "/resync" }
									hx-target="#kb-content"
									hx-swap="innerHTML"
									style="display:inline;margin-left:4px">
									<button type="submit" class="shell-button">↻ proyecto</button>
								</form>
							}
						</td>
					</tr>
				}
			</tbody>
		</table>
	}
}

// KnowledgeBaseStatusBadge pinta los counts globales arriba de la tabla.
templ KnowledgeBaseStatusBadge(stats KBStatusView) {
	<div style="display:flex;gap:0.75rem;margin-top:0.75rem;flex-wrap:wrap">
		<span class="badge" style="background:#3a5;color:#fff">ok: { fmt.Sprint(stats.OK) }</span>
		<span class="badge" style="background:#f5c842;color:#222">pending: { fmt.Sprint(stats.Pending) }</span>
		<span class="badge" style="background:#d35;color:#fff">failed: { fmt.Sprint(stats.Failed) }</span>
		<span class="badge badge-muted">skipped: { fmt.Sprint(stats.Skipped) }</span>
		<span class="badge badge-muted">total: { fmt.Sprint(stats.Total) }</span>
	</div>
}

// KnowledgeBaseSyncResult pinta el resultado de un sync manual de cotización.
templ KnowledgeBaseSyncResult(commit, path string) {
	<div class="card" style="background:#eaf6ea;border-left:4px solid #3a5;margin-top:0.5rem">
		<strong>✓ Sincronizada</strong>
		<br/><small>commit: <code>{ commit }</code></small>
		<br/><small>path: <code>{ path }</code></small>
	</div>
}

// KnowledgeBaseQuoteCard se inserta en la página de cotización para mostrar
// botones export DOCX + sync to KB + estado actual.
templ KnowledgeBaseQuoteCard(quoteID string, synced bool, commitSHA, repoPath string) {
	<div class="card" style="margin-top:1rem">
		<h3 style="margin-top:0">📚 Knowledge base</h3>
		if synced {
			<p class="muted">
				Última sincronización: commit <code>{ commitSHA }</code><br/>
				Path: <code>{ repoPath }</code>
			</p>
		} else {
			<p class="muted">Esta cotización aún no fue sincronizada al repo central.</p>
		}
		<div style="display:flex;gap:0.5rem;flex-wrap:wrap">
			<a href={ templ.SafeURL("/v1/cotizador/quotes/" + quoteID + "/export/docx") }
				class="shell-button"
				download="propuesta.docx">📄 Descargar .docx</a>
			<a href={ templ.SafeURL("/v1/cotizador/quotes/" + quoteID + "/export/markdown") }
				class="shell-button"
				download="propuesta.md">📝 Descargar .md</a>
			<form hx-post={ "/dashboard/knowledge-base/quotes/" + quoteID + "/sync" }
				hx-target="this"
				hx-swap="outerHTML"
				style="display:inline">
				<button type="submit" class="shell-button" style="background:#3265ae;color:#fff">☁ Sincronizar a knowledge base</button>
			</form>
		</div>
	</div>
}

templ kbStatusBadge(status string) {
	switch status {
		case "ok":
			<span class="badge" style="background:#3a5;color:#fff">{ status }</span>
		case "failed":
			<span class="badge" style="background:#d35;color:#fff">{ status }</span>
		case "pending":
			<span class="badge" style="background:#f5c842;color:#222">{ status }</span>
		default:
			<span class="badge badge-muted">{ status }</span>
	}
}
