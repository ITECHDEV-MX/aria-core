package dashboard

// CotizadorHomePage — shell del módulo Cotizador con form crear lead + lista vía HTMX.
templ CotizadorHomePage() {
	<div class="main-header">
		<div>
			<p class="section-kicker">VENTAS</p>
			<h1>💼 Cotizaciones</h1>
			<p class="lead">Pipeline de leads, RFPs, propuestas y conversión a clientes/proyectos.</p>
		</div>
		<div class="main-actions">
			<a href="/dashboard/cotizador/stats" class="btn btn-outline">📊 Stats & Pipeline</a>
		</div>
	</div>

	<div class="card">
		<div class="card-header">
			<div class="card-title">Nuevo lead</div>
			<p class="card-description">Captura inicial — luego podés sumar RFP y cotización desde el detalle.</p>
		</div>
		<form hx-post="/dashboard/cotizador/leads/create" hx-target="#cotizador-leads-content" hx-swap="innerHTML">
			<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:0.75rem">
				<label style="margin:0">
					Nombre del contacto
					<input type="text" name="name" placeholder="Juan Pérez" required/>
				</label>
				<label style="margin:0">
					Empresa
					<input type="text" name="company" placeholder="Acme SA"/>
				</label>
				<label style="margin:0">
					Email
					<input type="email" name="email" placeholder="contacto@acme.com"/>
				</label>
				<label style="margin:0">
					Teléfono
					<input type="text" name="phone" placeholder="+52 555 ..."/>
				</label>
				<label style="margin:0">
					Origen
					<input type="text" name="source" placeholder="referido, LinkedIn, evento..."/>
				</label>
			</div>
			<label style="margin-top:0.75rem">
				Notas
				<textarea name="notes" rows="2" placeholder="contexto inicial, requerimientos resumidos..."></textarea>
			</label>
			<button type="submit" class="btn btn-primary" style="margin-top:0.5rem">+ Crear lead</button>
		</form>
	</div>

	<div class="card">
		<div class="card-header">
			<div class="card-title">Leads</div>
			<p class="card-description">Filtrá por estado del funnel.</p>
		</div>
		<div style="display:flex;flex-wrap:wrap;gap:0.4rem;margin-bottom:1rem">
			<button hx-get="/dashboard/cotizador/leads/list" hx-target="#cotizador-leads-content" hx-swap="innerHTML" class="btn btn-outline btn-sm">Todos</button>
			for _, st := range cotizadorLeadStatuses() {
				<button hx-get={ "/dashboard/cotizador/leads/list?status=" + st.Value } hx-target="#cotizador-leads-content" hx-swap="innerHTML" class="btn btn-outline btn-sm">{ st.Label }</button>
			}
		</div>
		<div id="cotizador-leads-content"
			hx-get="/dashboard/cotizador/leads/list"
			hx-trigger="load"
			hx-swap="innerHTML">
			<p class="muted">Cargando...</p>
		</div>
	</div>
}

// CotizadorLeadsPartial — tabla de leads (filtrable por status).
templ CotizadorLeadsPartial(leads []CotizadorLeadView, errorMsg, currentStatus string) {
	if errorMsg != "" {
		<div class="login-error" role="alert">{ errorMsg }</div>
	}
	if currentStatus != "" {
		<p class="muted">Filtro activo: <strong>{ cotizadorStatusLabel(currentStatus) }</strong></p>
	}
	if len(leads) == 0 {
		@EmptyState("Sin leads", "No hay leads para este filtro. Creá uno con el formulario de arriba.")
	} else {
		<div class="table-wrapper">
			<table class="data-table">
				<thead>
					<tr>
						<th>Nombre</th>
						<th>Empresa</th>
						<th>Email</th>
						<th>Estado</th>
						<th>Creado</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					for _, l := range leads {
						<tr>
							<td><strong>{ l.Name }</strong></td>
							<td>{ l.Company }</td>
							<td><span class="muted" style="font-size:0.85rem">{ l.Email }</span></td>
							<td><span class={ "badge badge-" + cotizadorStatusVariant(l.Status) }>{ cotizadorStatusLabel(l.Status) }</span></td>
							<td><span class="muted" style="font-size:0.85rem">{ formatTimestampTime(l.CreatedAt) }</span></td>
							<td><a href={ templ.SafeURL("/dashboard/cotizador/leads/" + l.ID) } class="btn btn-outline btn-sm">Abrir →</a></td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}

// CotizadorLeadDetail — vista detalle con form edit + status change + history.
templ CotizadorLeadDetail(l *CotizadorLeadView, history []CotizadorLeadHistoryView) {
	<section class="frame-section">
		<div class="section-header">
			<div>
				<p class="section-kicker">LEAD</p>
				<h2>{ l.Name }</h2>
				<p class="muted">{ l.Company } · estado actual: <strong>{ cotizadorStatusLabel(l.Status) }</strong></p>
			</div>
			<div>
				<a href="/dashboard/cotizador" class="shell-button">← Volver</a>
			</div>
		</div>

		<h3 class="section-block-title">Editar datos</h3>
		<form hx-post={ "/dashboard/cotizador/leads/" + l.ID + "/update" } hx-target="closest section" hx-swap="outerHTML" class="login-form" style="max-width:680px">
			<label>Nombre <input type="text" name="name" value={ l.Name } required/></label>
			<label>Empresa <input type="text" name="company" value={ l.Company }/></label>
			<label>Email <input type="email" name="email" value={ l.Email }/></label>
			<label>Teléfono <input type="text" name="phone" value={ l.Phone }/></label>
			<label>Origen <input type="text" name="source" value={ l.Source }/></label>
			<label>Notas <textarea name="notes" rows="4">{ l.Notes }</textarea></label>
			<button type="submit" class="shell-button">Guardar cambios</button>
		</form>

		<h3 class="section-block-title">Cambiar estado</h3>
		<form hx-post={ "/dashboard/cotizador/leads/" + l.ID + "/status" } hx-target="closest section" hx-swap="outerHTML" class="login-form" style="max-width:680px">
			<label>
				Nuevo estado
				<select name="status">
					for _, st := range cotizadorLeadStatuses() {
						<option value={ st.Value } selected?={ st.Value == l.Status }>{ st.Label }</option>
					}
				</select>
			</label>
			<label>Notas del cambio <textarea name="notes" rows="2"></textarea></label>
			<button type="submit" class="shell-button">Cambiar estado</button>
		</form>

		<h3 class="section-block-title">Historial</h3>
		if len(history) == 0 {
			<p class="muted">Sin historial.</p>
		} else {
			<table class="data-table">
				<thead><tr><th>Fecha</th><th>Acción</th><th>De</th><th>A</th><th>Notas</th></tr></thead>
				<tbody>
					for _, e := range history {
						<tr>
							<td>{ formatTimestampTime(e.OccurredAt) }</td>
							<td>{ e.Action }</td>
							<td>{ e.FromStatus }</td>
							<td>{ e.ToStatus }</td>
							<td>{ e.Notes }</td>
						</tr>
					}
				</tbody>
			</table>
		}
	</section>
}
