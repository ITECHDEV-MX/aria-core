package dashboard

import (
	"fmt"
	"strconv"
	"strings"
	"time"
)

// ChatSessionView mirrors cotizador.ChatSession for the dashboard layer.
type ChatSessionView struct {
	ID          string
	LeadID      string
	RFPID       string
	QuoteID     string
	TemplateKey string
	Title       string
	Status      string
	CreatedAt   time.Time
	UpdatedAt   time.Time
	FinalizedAt *time.Time
	LeadName    string
	LeadCompany string
}

// ChatMessageView mirrors cotizador.ChatMessage for the dashboard layer.
// Only ContentMD is shown (real values, never the scrubbed payload).
type ChatMessageView struct {
	ID            string
	SessionID     string
	Role          string
	ContentMD     string
	ChannelCallID string
	Channel       string
	Model         string
	CreatedAt     time.Time
	Attachments   []ChatAttachmentView
}

// ChatAttachmentView is the metadata stored with a user message.
type ChatAttachmentView struct {
	AttachmentID string
	Filename     string
	MIME         string
	Size         int64
}

// ChatPreviewSectionView is one section of the live quote preview pane.
type ChatPreviewSectionView struct {
	Key       string
	Title     string
	ContentMD string
	SortOrder int
}

// EmailPreviewView is the data shown inside the email-confirm modal.
type EmailPreviewView struct {
	QuoteID   string
	SessionID string
	To        string
	CC        string
	Subject   string
	BodyHTML  string
	HasPDF    bool
}

// CotizadorQuoteChatPage is the full page (loaded on first GET).
templ CotizadorQuoteChatPage(sess *ChatSessionView, messages []ChatMessageView, sections []ChatPreviewSectionView, errorMsg string) {
	<style>
		.quote-chat-container { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; min-height: 70vh; }
		@media (max-width: 1024px) { .quote-chat-container { grid-template-columns: 1fr; } }
		.chat-pane { display: flex; flex-direction: column; min-height: 0; }
		.chat-history { flex: 1; overflow-y: auto; padding: 0.5rem; border: 1px solid #2a2a2a; border-radius: 6px; background: #0d0d0d; }
		.chat-msg { margin-bottom: 0.75rem; padding: 0.6rem 0.8rem; border-radius: 6px; max-width: 90%; }
		.chat-msg.user { background: #1c2c4a; margin-left: auto; }
		.chat-msg.assistant { background: #1a1a1a; margin-right: auto; }
		.chat-msg.system { background: #3a2a1a; margin: 0 auto; text-align: center; font-style: italic; max-width: 70%; }
		.chat-msg .meta { font-size: 0.7rem; color: #888; margin-bottom: 0.25rem; display: flex; justify-content: space-between; gap: 0.5rem; }
		.chat-msg pre { white-space: pre-wrap; word-wrap: break-word; font-family: inherit; margin: 0; }
		.chat-input { display: flex; flex-direction: column; gap: 0.5rem; margin-top: 0.5rem; }
		.chat-input textarea { width: 100%; min-height: 60px; resize: vertical; }
		.chat-attachments { display: flex; flex-wrap: wrap; gap: 0.4rem; }
		.chat-attachments .file-tag { font-size: 0.75rem; background: #1a1a1a; padding: 0.2rem 0.4rem; border-radius: 4px; }
		.preview-pane { display: flex; flex-direction: column; min-height: 0; }
		.preview-content { flex: 1; overflow-y: auto; padding: 1rem; border: 1px solid #2a2a2a; border-radius: 6px; background: #0d0d0d; }
		.preview-section { margin-bottom: 1rem; padding: 0.75rem; background: #161616; border-radius: 4px; }
		.preview-section summary { cursor: pointer; font-weight: 600; color: #fff; }
		.preview-section .body { margin-top: 0.5rem; font-size: 0.9rem; color: #ccc; white-space: pre-wrap; }
		.preview-section .actions { margin-top: 0.4rem; display: flex; gap: 0.4rem; }
		.preview-actions { display: flex; gap: 0.5rem; margin-top: 0.5rem; flex-wrap: wrap; }
		.email-modal-backdrop { position: fixed; inset: 0; background: rgba(0,0,0,0.7); z-index: 999; display: flex; align-items: center; justify-content: center; padding: 1rem; }
		.email-modal { background: #161616; border-radius: 8px; max-width: 720px; width: 100%; padding: 1.5rem; max-height: 90vh; overflow-y: auto; }
		.email-modal h3 { margin-top: 0; }
		.email-modal label { display: block; margin: 0.5rem 0; }
		.email-modal label > span { font-size: 0.75rem; letter-spacing: 0.1em; text-transform: uppercase; color: #888; display: block; margin-bottom: 0.2rem; }
		.email-modal input[type="text"], .email-modal input[type="email"] { width: 100%; }
		.email-modal-body { background: #0d0d0d; border: 1px solid #2a2a2a; border-radius: 4px; padding: 0.75rem; margin-top: 0.4rem; max-height: 240px; overflow-y: auto; font-size: 0.85rem; }
		.email-modal-actions { display: flex; gap: 0.5rem; justify-content: flex-end; margin-top: 1rem; }
		.spinner { display: inline-block; width: 1em; height: 1em; border: 2px solid #888; border-top-color: transparent; border-radius: 50%; animation: spin 0.8s linear infinite; }
		@keyframes spin { to { transform: rotate(360deg); } }
	</style>

	<div class="main-header">
		<div>
			<p class="section-kicker">QUOTE-CHAT</p>
			<h1>💬 { sess.Title }</h1>
			<p class="muted">
				Lead:
				if sess.LeadName != "" {
					<a href={ templ.SafeURL("/dashboard/cotizador/leads/" + sess.LeadID) }>{ sess.LeadName }</a>
				} else {
					<em>(sin lead)</em>
				}
				· Template: <code>{ sess.TemplateKey }</code>
				· Estado: <strong>{ chatStatusLabel(sess.Status) }</strong>
			</p>
		</div>
		<div class="main-actions">
			<a href="/dashboard/cotizador" class="btn btn-outline">← Volver</a>
		</div>
	</div>

	if errorMsg != "" {
		<div class="login-error" role="alert">{ errorMsg }</div>
	}

	<div class="quote-chat-container" id="quote-chat-root" data-session-id={ sess.ID }>
		<!-- LEFT PANE: chat -->
		<div class="chat-pane card">
			<div class="card-header">
				<div class="card-title">Diálogo con la IA</div>
				<p class="card-description muted">Datos del cliente se ofuscan antes de salir del VPS. Vos ves los reales acá.</p>
			</div>
			<div class="chat-history" id="chat-history">
				@CotizadorChatMessagesPartial(messages)
			</div>
			<form class="chat-input" hx-post={ "/dashboard/cotizador/quote-chat/" + sess.ID + "/send" }
				  hx-target="#chat-history" hx-swap="outerHTML"
				  hx-indicator="#chat-spinner">
				<textarea name="message" rows="3" placeholder="Pediles a la IA que arme la próxima sección, sumá restricciones, etc." required></textarea>
				<div class="chat-attachments" id="chat-attachments-list"></div>
				<div style="display:flex;gap:0.5rem;align-items:center">
					<button type="submit" class="btn btn-primary">💬 Enviar</button>
					<span id="chat-spinner" class="htmx-indicator muted"><span class="spinner"></span> Claude está pensando...</span>
				</div>
			</form>
		</div>

		<!-- RIGHT PANE: live quote preview -->
		<div class="preview-pane card">
			<div class="card-header">
				<div class="card-title">Vista previa de la cotización</div>
				<p class="card-description muted">Se actualiza a medida que la IA escribe secciones.</p>
			</div>
			<div class="preview-content" id="quote-preview"
				 hx-get={ "/dashboard/cotizador/quote-chat/" + sess.ID + "/preview" }
				 hx-trigger="every 5s"
				 hx-swap="innerHTML">
				@CotizadorChatPreviewPartial(sess, sections)
			</div>
			<div class="preview-actions">
				<form hx-post={ "/dashboard/cotizador/quote-chat/" + sess.ID + "/finalize" }
					  hx-target="#quote-chat-root" hx-swap="outerHTML">
					<button type="submit" class="btn btn-primary"
						if sess.Status != "in_progress" {
							disabled
						}>✓ Finalizar quote</button>
				</form>
				if sess.QuoteID != "" {
					<button class="btn btn-outline"
						hx-get={ "/dashboard/cotizador/quote-chat/" + sess.ID + "/email-preview" }
						hx-target="body" hx-swap="beforeend">📧 Email cliente</button>
				}
			</div>
		</div>
	</div>
}

// CotizadorChatMessagesPartial — re-renders the full chat history list. The
// outer wrapper id="chat-history" is included so HTMX can swap the entire
// element after each send.
templ CotizadorChatMessagesPartial(messages []ChatMessageView) {
	<div class="chat-history" id="chat-history">
		if len(messages) == 0 {
			<p class="muted">Conversación vacía. Empieza pidiendo a la IA un resumen ejecutivo.</p>
		}
		for _, m := range messages {
			<div class={ "chat-msg " + chatRoleClass(m.Role) }>
				<div class="meta">
					<span><strong>{ chatRoleLabel(m.Role) }</strong> · { formatTimestampTime(m.CreatedAt) }</span>
					if m.Channel != "" {
						<span class="muted">{ m.Channel } / { m.Model }</span>
					}
				</div>
				<pre>{ m.ContentMD }</pre>
				if len(m.Attachments) > 0 {
					<div class="chat-attachments" style="margin-top:0.4rem">
						for _, a := range m.Attachments {
							<span class="file-tag">📎 { a.Filename } ({ humanSize(a.Size) })</span>
						}
					</div>
				}
			</div>
		}
	</div>
}

// CotizadorChatPreviewPartial — quote preview, partial used by the right pane.
templ CotizadorChatPreviewPartial(sess *ChatSessionView, sections []ChatPreviewSectionView) {
	if len(sections) == 0 {
		<p class="muted">Aún no hay secciones generadas. Pediles a la IA <em>"armá un resumen ejecutivo para esta cotización"</em>.</p>
	} else {
		for _, s := range sections {
			<details class="preview-section" open>
				<summary>{ s.Title }</summary>
				<div class="body">{ s.ContentMD }</div>
				if sess.Status == "in_progress" && sess.QuoteID != "" {
					<div class="actions">
						<button class="btn btn-outline btn-sm"
							hx-get={ "/dashboard/cotizador/quote-chat/" + sess.ID + "/sections/" + s.Key + "/edit" }
							hx-target="closest details" hx-swap="outerHTML">✏️ Editar</button>
					</div>
				}
			</details>
		}
	}
}

// CotizadorChatSectionEditPartial — inline editor for one section.
templ CotizadorChatSectionEditPartial(sess *ChatSessionView, key, title, content string) {
	<details class="preview-section" open>
		<summary>{ title } (editando)</summary>
		<form hx-post={ "/dashboard/cotizador/quote-chat/" + sess.ID + "/sections/" + key + "/save" }
			  hx-target="closest details" hx-swap="outerHTML">
			<input type="hidden" name="title" value={ title }/>
			<textarea name="content_md" rows="8" style="width:100%">{ content }</textarea>
			<div style="display:flex;gap:0.5rem;margin-top:0.4rem">
				<button type="submit" class="btn btn-primary btn-sm">💾 Guardar</button>
				<button type="button" class="btn btn-outline btn-sm"
					hx-get={ "/dashboard/cotizador/quote-chat/" + sess.ID + "/preview" }
					hx-target="#quote-preview" hx-swap="innerHTML">Cancelar</button>
			</div>
		</form>
	</details>
}

// CotizadorChatEmailModal — full-screen modal previewing the outbound email.
// Sending requires the explicit "Confirmar envío" button — there is no
// auto-send code path anywhere in the system.
templ CotizadorChatEmailModal(view *EmailPreviewView) {
	<div class="email-modal-backdrop" id="email-modal-root">
		<div class="email-modal">
			<h3>📧 Vista previa del email</h3>
			<p class="muted">Revisá el contenido, ajustá lo que haga falta. <strong>Nada se envía hasta que aprietes "Confirmar envío"</strong>.</p>

			<form hx-post={ "/dashboard/cotizador/quote-chat/" + view.SessionID + "/email-send" }
				  hx-target="#email-modal-root" hx-swap="outerHTML">
				<input type="hidden" name="quote_id" value={ view.QuoteID }/>

				<label>
					<span>Para</span>
					<input type="email" name="to" value={ view.To } required/>
				</label>
				<label>
					<span>CC</span>
					<input type="text" name="cc" value={ view.CC } placeholder="opcional, separado por comas"/>
				</label>
				<label>
					<span>Asunto</span>
					<input type="text" name="subject" value={ view.Subject } required/>
				</label>
				<label>
					<span>Cuerpo (HTML)</span>
					<textarea name="body" rows="10" style="width:100%">{ view.BodyHTML }</textarea>
				</label>
				<div class="email-modal-body">
					<small class="muted">Vista renderizada (read-only):</small>
					@templ.Raw(view.BodyHTML)
				</div>

				<div class="email-modal-actions">
					<button type="button" class="btn btn-outline"
						onclick="document.getElementById('email-modal-root').remove()">Cancelar</button>
					<button type="submit" class="btn btn-primary">✉️ Confirmar envío a { view.To }</button>
				</div>
			</form>
		</div>
	</div>
}

// CotizadorChatEmailSentToast — replaces the modal after successful send.
templ CotizadorChatEmailSentToast(recipient string) {
	<div id="email-modal-root" style="position:fixed; bottom:1rem; right:1rem; background:#1a3a1a; color:#cfe9cf; padding:0.75rem 1rem; border-radius:6px; z-index:998">
		✓ Email enviado a <strong>{ recipient }</strong>
	</div>
}

// CotizadorChatEmailErrorToast — replaces the modal after a failed send.
templ CotizadorChatEmailErrorToast(errMsg string) {
	<div id="email-modal-root" style="position:fixed; bottom:1rem; right:1rem; background:#3a1a1a; color:#e9cfcf; padding:0.75rem 1rem; border-radius:6px; z-index:998">
		⚠️ No se pudo enviar: { errMsg }
	</div>
}

// CotizadorChatNewSessionForm — small form to create a new session from a lead detail page.
templ CotizadorChatNewSessionForm(leadID, leadName string, templates []CotizadorTemplateView) {
	<form hx-post="/dashboard/cotizador/quote-chat/create" hx-target="closest section" hx-swap="outerHTML"
		  style="display:grid;gap:0.5rem;max-width:480px">
		<input type="hidden" name="lead_id" value={ leadID }/>
		<label>
			Título de la cotización
			<input type="text" name="title" value={ "Cotización para " + leadName } required/>
		</label>
		<label>
			Template
			<select name="template_key">
				for _, t := range templates {
					<option value={ t.Key }>{ t.Name }</option>
				}
			</select>
		</label>
		<button type="submit" class="btn btn-primary">💬 Iniciar quote-chat</button>
	</form>
}

// chatRoleClass returns the CSS class to use for a chat message's role.
func chatRoleClass(role string) string {
	switch strings.ToLower(role) {
	case "user":
		return "user"
	case "assistant":
		return "assistant"
	default:
		return "system"
	}
}

// chatRoleLabel returns the human label for a role.
func chatRoleLabel(role string) string {
	switch strings.ToLower(role) {
	case "user":
		return "JC"
	case "assistant":
		return "IA"
	default:
		return "Sistema"
	}
}

// chatStatusLabel returns the human label for a session status.
func chatStatusLabel(status string) string {
	switch strings.ToLower(status) {
	case "in_progress":
		return "En curso"
	case "finalized":
		return "Finalizada"
	case "abandoned":
		return "Abandonada"
	default:
		return status
	}
}

// humanSize returns a "X.X KB" style formatted size.
func humanSize(b int64) string {
	if b < 1024 {
		return fmt.Sprintf("%d B", b)
	}
	if b < 1024*1024 {
		return strconv.FormatFloat(float64(b)/1024, 'f', 1, 64) + " KB"
	}
	return strconv.FormatFloat(float64(b)/(1024*1024), 'f', 1, 64) + " MB"
}
