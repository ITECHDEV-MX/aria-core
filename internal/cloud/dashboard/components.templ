package dashboard

import (
	"fmt"
	"net/url"

	"github.com/ITECHDEV-MX/aria-core/internal/cloud/cloudstore"
)

// ─── Shared Components ──────────────────────────────────────────────────────

// NavTabs renders the navigation tab bar.
// activeTab should be one of: "dashboard", "browser", "projects", "contributors", "admin".
templ NavTabs(activeTab string, roles []string) {
	<div role="tablist">
		@navTab("/dashboard/", "Inicio", "dashboard", activeTab)
		@navTab("/dashboard/ayuda", "Guía", "ayuda", activeTab)
		@navTab("/dashboard/memorias", "Memoria", "memorias", activeTab)
		if hasAnyRole(roles, "admin", "dev") {
			@navTab("/dashboard/browser", "Sync", "browser", activeTab)
		}
		if hasAnyRole(roles, "admin", "dev", "project_admin") {
			@navTab("/dashboard/projects", "Proyectos", "projects", activeTab)
		}
		if hasAnyRole(roles, "admin", "cotizador") {
			@navTab("/dashboard/cotizador", "Cotizaciones", "cotizador", activeTab)
		}
		if hasAnyRole(roles, "admin") {
			@navTab("/dashboard/contributors", "Colaboradores", "contributors", activeTab)
			@navTab("/dashboard/admin", "Administración", "admin", activeTab)
		}
	</div>
}

// navTab renders a single nav tab link.
templ navTab(href string, label string, tabID string, activeTab string) {
	if tabID == activeTab {
		<a href={ templ.SafeURL(href) } role="tab" aria-selected="true">{ label }</a>
	} else {
		<a href={ templ.SafeURL(href) } role="tab" aria-selected="false">{ label }</a>
	}
}

// StatusBadge renders a colored status badge.
// variant should be one of: "success", "warning", "danger", "muted".
templ StatusBadge(label string, variant string) {
	<span class={ "badge badge-" + variant }>{ label }</span>
}

// EmptyState renders a centered empty-state placeholder.
templ EmptyState(title string, message string) {
	<div class="empty-state">
		<p class="section-kicker">SIN DATOS</p>
		<h3>{ title }</h3>
		<p>{ message }</p>
	</div>
}

// PaginationBar renders page navigation controls with a page-size selector.
// baseURL is the path without query params (e.g. "/dashboard/projects").
// extraParams preserves existing query params (project, q, type, etc.).
templ PaginationBar(pg Pagination, baseURL string, extraParams map[string]string) {
	if pg.ShowPagination() {
		<div class="pagination-bar">
			<span class="pagination-info">{ fmt.Sprintf("%d–%d de %d", pg.Start(), pg.End(), pg.TotalItems) }</span>
			<div class="pagination-pages">
				if pg.HasPrev() {
					<a href={ templ.SafeURL(paginationURL(baseURL, pg.Page-1, pg.PageSize, extraParams)) } class="page-btn">←</a>
				}
				for _, n := range pg.PageNumbers() {
					if n == -1 {
						<span class="page-ellipsis">…</span>
					} else if n == pg.Page {
						<span class="page-btn active">{ fmt.Sprint(n) }</span>
					} else {
						<a href={ templ.SafeURL(paginationURL(baseURL, n, pg.PageSize, extraParams)) } class="page-btn">{ fmt.Sprint(n) }</a>
					}
				}
				if pg.HasNext() {
					<a href={ templ.SafeURL(paginationURL(baseURL, pg.Page+1, pg.PageSize, extraParams)) } class="page-btn">→</a>
				}
			</div>
			<div class="pagination-size">
				<span class="pagination-size-label">Mostrar</span>
				for _, size := range allowedPageSizes {
					if size == pg.PageSize {
						<span class="page-btn active">{ fmt.Sprint(size) }</span>
					} else {
						<a href={ templ.SafeURL(paginationURL(baseURL, 1, size, extraParams)) } class="page-btn">{ fmt.Sprint(size) }</a>
					}
				}
			</div>
		</div>
	}
}

// HtmxPaginationBar is the same but triggers htmx requests instead of full-page navigation.
// target is the htmx target element (e.g. "#browser-content"), includes are extra hx-include selectors.
// endpoint must be the bare path WITHOUT a trailing "?" (e.g. "/dashboard/browser/observations").
// R4-2: URL format uses "?page=..." not "&page=..." to avoid malformed ?& URLs.
templ HtmxPaginationBar(pg Pagination, endpoint string, target string, includes string) {
	if pg.ShowPagination() {
		<div class="pagination-bar">
			<span class="pagination-info">{ fmt.Sprintf("%d–%d de %d", pg.Start(), pg.End(), pg.TotalItems) }</span>
			<div class="pagination-pages">
				if pg.HasPrev() {
					<a class="page-btn" hx-get={ fmt.Sprintf("%s?page=%d&pageSize=%d", endpoint, pg.Page-1, pg.PageSize) } hx-target={ target } hx-swap="innerHTML" hx-include={ includes }>←</a>
				}
				for _, n := range pg.PageNumbers() {
					if n == -1 {
						<span class="page-ellipsis">…</span>
					} else if n == pg.Page {
						<span class="page-btn active">{ fmt.Sprint(n) }</span>
					} else {
						<a class="page-btn" hx-get={ fmt.Sprintf("%s?page=%d&pageSize=%d", endpoint, n, pg.PageSize) } hx-target={ target } hx-swap="innerHTML" hx-include={ includes }>{ fmt.Sprint(n) }</a>
					}
				}
				if pg.HasNext() {
					<a class="page-btn" hx-get={ fmt.Sprintf("%s?page=%d&pageSize=%d", endpoint, pg.Page+1, pg.PageSize) } hx-target={ target } hx-swap="innerHTML" hx-include={ includes }>→</a>
				}
			</div>
			<div class="pagination-size">
				<span class="pagination-size-label">Mostrar</span>
				for _, size := range allowedPageSizes {
					if size == pg.PageSize {
						<span class="page-btn active">{ fmt.Sprint(size) }</span>
					} else {
						<a class="page-btn" hx-get={ fmt.Sprintf("%s?page=1&pageSize=%d", endpoint, size) } hx-target={ target } hx-swap="innerHTML" hx-include={ includes }>{ fmt.Sprint(size) }</a>
					}
				}
			</div>
		</div>
	}
}

// ─── Phase 4: Dashboard Overview ────────────────────────────────────────────

// DashboardHome renders the main dashboard landing content with project stats.
// ADAPTED: username comes from Principal.DisplayName() at the call site.
templ DashboardHome(username string) {
	<div class="main-header">
		<div>
			<p class="section-kicker">PANEL DE CONTROL</p>
			<h1>Hola, { username }</h1>
			<p class="lead">Tu espacio de memoria compartida y operación comercial. Buscá decisiones del equipo, alimenta el contexto de tu Claude o ingresá directo al pipeline de cotizaciones.</p>
		</div>
	</div>
	<div id="dashboard-stats" hx-get="/dashboard/stats" hx-trigger="load" hx-swap="innerHTML">
		<p class="muted">Cargando estadísticas...</p>
	</div>

	<div class="card" style="margin-top:1.5rem">
		<div class="card-header">
			<div class="card-title">Accesos rápidos</div>
			<p class="card-description">Lo que más usas a diario.</p>
		</div>
		<div class="stat-grid">
			<a href="/dashboard/memorias" class="stat-card" style="text-decoration:none">
				<div class="stat-label">💡 Memoria</div>
				<div class="stat-value" style="font-size:1rem;font-family:var(--font-sans)">Buscar decisiones, ADRs y aprendizajes del equipo</div>
			</a>
			<a href="/dashboard/cotizador" class="stat-card" style="text-decoration:none">
				<div class="stat-label">💼 Cotizaciones</div>
				<div class="stat-value" style="font-size:1rem;font-family:var(--font-sans)">Pipeline ventas, RFPs, propuestas con histórico</div>
			</a>
			<a href="/dashboard/ayuda" class="stat-card" style="text-decoration:none">
				<div class="stat-label">📖 Guía</div>
				<div class="stat-value" style="font-size:1rem;font-family:var(--font-sans)">Setup, workflow y convenciones del equipo</div>
			</a>
			<a href="/dashboard/admin/mcp" class="stat-card" style="text-decoration:none">
				<div class="stat-label">🤖 MCP & Tools</div>
				<div class="stat-value" style="font-size:1rem;font-family:var(--font-sans)">Configurá Claude Desktop con aria-core</div>
			</a>
		</div>
	</div>
}

// DashboardStatsPartial renders the metric cards loaded via htmx.
// ADAPTED: ProjectStat -> DashboardProjectRow; no LastActivity field (use Chunks).
templ DashboardStatsPartial(stats []cloudstore.DashboardProjectRow, projects []string) {
	if len(stats) == 0 {
		<div class="stat-grid">
			<div class="stat-card">
				<div class="stat-label">Proyectos enrolados</div>
				<div class="stat-value">{ fmt.Sprint(len(projects)) }</div>
			</div>
		</div>
		if len(projects) > 0 {
			<div style="display:flex;flex-wrap:wrap;gap:0.4rem;margin:0.75rem 0">
				for i, p := range projects {
					if i < maxPills {
						@StatusBadge(p, "success")
					}
				}
				if len(projects) > maxPills {
					<a href="/dashboard/projects" class="badge badge-muted">+{ fmt.Sprint(len(projects) - maxPills) } más</a>
				}
			</div>
		}
		@EmptyState("Sin proyectos sincronizados", "Las métricas aparecerán aquí después del primer sync exitoso.")
	} else {
		<div class="stat-grid">
			<a href="/dashboard/browser?tab=sessions" class="stat-card" style="text-decoration:none">
				<div class="stat-label">Sesiones</div>
				<div class="stat-value">{ fmt.Sprint(totalStatSessions(stats)) }</div>
			</a>
			<a href="/dashboard/browser" class="stat-card" style="text-decoration:none">
				<div class="stat-label">Observaciones sync</div>
				<div class="stat-value">{ fmt.Sprint(totalStatObservations(stats)) }</div>
			</a>
			<a href="/dashboard/browser?tab=prompts" class="stat-card" style="text-decoration:none">
				<div class="stat-label">Prompts</div>
				<div class="stat-value">{ fmt.Sprint(totalStatPrompts(stats)) }</div>
			</a>
			<a href="/dashboard/projects" class="stat-card" style="text-decoration:none">
				<div class="stat-label">Proyectos</div>
				<div class="stat-value">{ fmt.Sprint(len(stats)) }</div>
			</a>
		</div>
		<div style="display:flex;flex-wrap:wrap;gap:0.4rem;margin:0.75rem 0">
			for i, p := range projects {
				if i < maxPills {
					@StatusBadge(p, "success")
				}
			}
			if len(projects) > maxPills {
				<a href="/dashboard/projects" class="badge badge-muted">+{ fmt.Sprint(len(projects) - maxPills) } más</a>
			}
		</div>
		<div class="project-chip-list metric-tags">
			for i, p := range projects {
				if i < maxPills {
					@StatusBadge(p, "success")
				}
			}
			if len(projects) > maxPills {
				<a href="/dashboard/projects" class="badge badge-muted">+{ fmt.Sprint(len(projects) - maxPills) } more</a>
			}
		</div>
		<div class="card" style="margin-top:1.5rem">
			<div class="card-header">
				<div class="card-title">Actividad del proyecto</div>
				<p class="card-description">Índice en vivo — sesiones, observaciones y prompts por proyecto.</p>
			</div>
			<form>
				<label style="margin:0 0 0.75rem">
					<input
						id="activity-search"
						type="search"
						name="q"
						placeholder="🔍 Buscar proyectos..."
						hx-get="/dashboard/activity"
						hx-target="#activity-content"
						hx-swap="innerHTML"
						hx-trigger="keyup changed delay:300ms"
					/>
				</label>
			</form>
			<div id="activity-content"
				hx-get="/dashboard/activity"
				hx-trigger="load"
				hx-swap="innerHTML"
				hx-include="#activity-search">
				<p class="muted">Cargando...</p>
			</div>
		</div>
	}
}

// DashboardActivityPartial renders the project activity table, loaded via htmx.
// ADAPTED: ProjectStat -> DashboardProjectRow; no LastActivity (omit that column).
templ DashboardActivityPartial(stats []cloudstore.DashboardProjectRow, pg Pagination) {
	if len(stats) == 0 {
		@EmptyState("Sin actividad", "Ningún proyecto coincide con la búsqueda.")
	} else {
		<div class="table-wrapper">
			<table class="data-table">
				<thead>
					<tr>
						<th>Proyecto</th>
						<th>Sesiones</th>
						<th>Observaciones</th>
						<th>Prompts</th>
					</tr>
				</thead>
				<tbody>
					for _, s := range stats {
						<tr>
							<td>
								<a href={ templ.SafeURL("/dashboard/projects/" + url.PathEscape(s.Project)) }>{ s.Project }</a>
							</td>
							<td>{ fmt.Sprint(s.Sessions) }</td>
							<td>{ fmt.Sprint(s.Observations) }</td>
							<td>{ fmt.Sprint(s.Prompts) }</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}

// ─── Phase 5: Knowledge Browser ─────────────────────────────────────────────

// BrowserPage renders the knowledge browser with subtabs and filter controls.
templ BrowserPage(projects []string, types []string, activeProject string, search string, activeType string) {
	<div class="main-header">
		<div>
			<p class="section-kicker">EXPLORADOR</p>
			<h1>🔄 Sync</h1>
			<p class="lead">Chunks engram-style sincronizados desde el cliente local. Buscá observaciones, sesiones y prompts del equipo.</p>
		</div>
	</div>

	<div class="card">
		<div class="card-header">
			<div class="card-title">Filtros</div>
			<p class="card-description">Refiná por proyecto, búsqueda libre y tipo de observación.</p>
		</div>
		<div style="display:grid;grid-template-columns:1fr 2fr;gap:0.75rem">
			<label style="margin:0">
				<select id="browser-project" name="project" hx-get="/dashboard/browser/observations" hx-target="#browser-content" hx-swap="innerHTML" hx-include="#browser-search, #browser-type">
					<option value="">Todos los proyectos</option>
					for _, p := range projects {
						if p == activeProject {
							<option value={ p } selected>{ p }</option>
						} else {
							<option value={ p }>{ p }</option>
						}
					}
				</select>
			</label>
			<label style="margin:0">
				<input
					id="browser-search"
					type="search"
					name="q"
					placeholder="🔍 Buscar..."
					value={ search }
					hx-get="/dashboard/browser/observations"
					hx-target="#browser-content"
					hx-swap="innerHTML"
					hx-trigger="keyup changed delay:300ms"
					hx-include="#browser-project, #browser-type"
				/>
			</label>
		</div>
		<input type="hidden" id="browser-type" name="type" value={ activeType }/>
		if len(types) > 0 {
			<div style="display:flex;flex-wrap:wrap;gap:0.4rem;margin-top:0.75rem">
				if activeType == "" {
					<a href={ templ.SafeURL(browserURL(activeProject, search, "")) } class="badge badge-primary" style="text-decoration:none">Todos los tipos</a>
				} else {
					<a href={ templ.SafeURL(browserURL(activeProject, search, "")) } class="badge badge-muted" style="text-decoration:none">Todos los tipos</a>
				}
				for _, obsType := range types {
					if activeType == obsType {
						<a href={ templ.SafeURL(browserURL(activeProject, search, obsType)) } class="badge badge-primary" style="text-decoration:none">{ obsType }</a>
					} else {
						<a href={ templ.SafeURL(browserURL(activeProject, search, obsType)) } class="badge badge-muted" style="text-decoration:none">{ obsType }</a>
					}
				}
			</div>
		}
	</div>

	<div class="card">
		<div role="tablist" id="browser-tabs" style="display:flex;flex-wrap:wrap;gap:0.4rem;margin-bottom:1rem">
			<button role="tab" aria-selected="true" class="btn btn-primary btn-sm active"
				hx-get="/dashboard/browser/observations"
				hx-target="#browser-content"
				hx-swap="innerHTML"
				hx-include="#browser-project, #browser-search, #browser-type"
				hx-on::after-request="document.querySelectorAll('#browser-tabs [role=tab]').forEach(t=>{t.classList.remove('active','btn-primary');t.classList.add('btn-outline')});this.classList.remove('btn-outline');this.classList.add('active','btn-primary')">Observaciones</button>
			<button role="tab" aria-selected="false" class="btn btn-outline btn-sm"
				hx-get="/dashboard/browser/sessions"
				hx-target="#browser-content"
				hx-swap="innerHTML"
				hx-include="#browser-project, #browser-search, #browser-type"
				hx-on::after-request="document.querySelectorAll('#browser-tabs [role=tab]').forEach(t=>{t.classList.remove('active','btn-primary');t.classList.add('btn-outline')});this.classList.remove('btn-outline');this.classList.add('active','btn-primary')">Sesiones</button>
			<button role="tab" aria-selected="false" class="btn btn-outline btn-sm"
				hx-get="/dashboard/browser/prompts"
				hx-target="#browser-content"
				hx-swap="innerHTML"
				hx-include="#browser-project, #browser-search, #browser-type"
				hx-on::after-request="document.querySelectorAll('#browser-tabs [role=tab]').forEach(t=>{t.classList.remove('active','btn-primary');t.classList.add('btn-outline')});this.classList.remove('btn-outline');this.classList.add('active','btn-primary')">Prompts</button>
		</div>
		<div id="browser-content" hx-get="/dashboard/browser/observations" hx-trigger="load" hx-swap="innerHTML" hx-include="#browser-project, #browser-search, #browser-type">
			<p class="muted">Cargando...</p>
		</div>
	</div>
}

// ObservationsPartial renders the observations list, loaded as an htmx partial.
// ADAPTED: CloudObservation -> DashboardObservationRow; composite URL for detail page.
// R3-1: HtmxPaginationBar added so users have visible page controls in the browser.
templ ObservationsPartial(observations []cloudstore.DashboardObservationRow, pg Pagination) {
	if len(observations) == 0 {
		@EmptyState("Sin observaciones", "Ninguna observación coincide con el proyecto, búsqueda o tipo de filtro activo.")
	} else {
		<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(340px,1fr));gap:1rem">
			for _, o := range observations {
				<a href={ templ.SafeURL(fmt.Sprintf("/dashboard/observations/%s/%s/%s", url.PathEscape(o.Project), url.PathEscape(o.SessionID), url.PathEscape(o.SyncID))) } class="card" style="text-decoration:none;color:inherit;display:flex;flex-direction:column">
					<div style="display:flex;flex-wrap:wrap;gap:0.4rem;margin-bottom:0.5rem">
						@StatusBadge(o.Type, typeBadgeVariant(o.Type))
						@StatusBadge(o.Project, "muted")
					</div>
					<h3 style="font-family:var(--font-sans);font-size:1rem;margin:0 0 0.5rem;line-height:1.35">{ o.Title }</h3>
					<p class="muted" style="font-size:0.85rem;margin:0 0 0.75rem;flex:1">{ renderInlineStructuredPreview(o.Content, 220) }</p>
					<div style="margin-top:auto;display:flex;justify-content:space-between;gap:0.5rem;padding-top:0.5rem;border-top:1px solid var(--border);font-size:0.75rem">
						<span class="muted">{ formatTimestamp(o.CreatedAt) }</span>
						<span class="muted">Sesión { o.SessionID }</span>
					</div>
				</a>
			}
		</div>
		@HtmxPaginationBar(pg, "/dashboard/browser/observations", "#browser-content", "#browser-project, #browser-search, #browser-type")
	}
}

// SessionsPartial renders the sessions list, loaded as an htmx partial.
// ADAPTED: CloudSessionSummary -> DashboardSessionRow; composite URL for detail page.
// R3-1: HtmxPaginationBar added so users have visible page controls in the browser.
templ SessionsPartial(sessions []cloudstore.DashboardSessionRow, pg Pagination) {
	if len(sessions) == 0 {
		@EmptyState("Sin sesiones", "Ninguna sesión coincide con el proyecto o filtro de búsqueda actual.")
	} else {
		<div class="table-wrapper">
			<table class="data-table">
				<thead>
					<tr>
						<th>Proyecto</th>
						<th>Iniciado</th>
						<th>Terminó</th>
						<th>Summary</th>
					</tr>
				</thead>
				<tbody>
					for _, s := range sessions {
						<tr>
							<td>
								<a href={ templ.SafeURL("/dashboard/sessions/" + url.PathEscape(s.Project) + "/" + url.PathEscape(s.SessionID)) }>{ s.Project }</a>
								<div class="muted" style="font-size:0.75rem">sesión { s.SessionID }</div>
							</td>
							<td>{ formatTimestamp(s.StartedAt) }</td>
							<td>
								if s.EndedAt != "" {
									{ formatTimestamp(s.EndedAt) }
								} else {
									@StatusBadge("Activa", "success")
								}
							</td>
							<td>{ truncateContent(s.Summary, 100) }</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
		@HtmxPaginationBar(pg, "/dashboard/browser/sessions", "#browser-content", "#browser-project, #browser-search, #browser-type")
	}
}

// PromptsPartial renders the prompts list, loaded as an htmx partial.
// ADAPTED: CloudPrompt -> DashboardPromptRow; composite URL for detail page.
// R3-1: HtmxPaginationBar added so users have visible page controls in the browser.
templ PromptsPartial(prompts []cloudstore.DashboardPromptRow, pg Pagination) {
	if len(prompts) == 0 {
		@EmptyState("Sin prompts", "Ningún prompt coincide con el proyecto o filtro de búsqueda actual.")
	} else {
		<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(340px,1fr));gap:1rem">
			for _, p := range prompts {
				<a href={ templ.SafeURL(fmt.Sprintf("/dashboard/prompts/%s/%s/%s", url.PathEscape(p.Project), url.PathEscape(p.SessionID), url.PathEscape(p.SyncID))) } class="card" style="text-decoration:none;color:inherit;display:flex;flex-direction:column">
					<div style="display:flex;flex-wrap:wrap;gap:0.4rem;margin-bottom:0.5rem">
						@StatusBadge(p.Project, "muted")
					</div>
					<p style="font-size:0.9rem;margin:0 0 0.75rem;flex:1;line-height:1.5">{ truncateContent(p.Content, 300) }</p>
					<div style="margin-top:auto;display:flex;justify-content:space-between;gap:0.5rem;padding-top:0.5rem;border-top:1px solid var(--border);font-size:0.75rem">
						<span class="muted">{ formatTimestamp(p.CreatedAt) }</span>
						<span class="muted">Sesión { p.SessionID }</span>
					</div>
				</a>
			}
		</div>
		@HtmxPaginationBar(pg, "/dashboard/browser/prompts", "#browser-content", "#browser-project, #browser-search, #browser-type")
	}
}

// PromptDetailPage renders a prompt detail page.
// ADAPTED: CloudPrompt -> DashboardPromptRow; CloudSession -> DashboardSessionRow.
templ PromptDetailPage(prompt *cloudstore.DashboardPromptRow, session *cloudstore.DashboardSessionRow, related []cloudstore.DashboardPromptRow) {
	<div class="main-header">
		<div>
			<p class="section-kicker">DETALLE PROMPT</p>
			<h1>💬 Prompt</h1>
			if prompt != nil {
				<p class="lead">Sesión <code>{ prompt.SessionID }</code> · Proyecto <strong>{ prompt.Project }</strong></p>
			}
		</div>
		<div class="main-actions">
			<a href="/dashboard/browser" class="btn btn-outline">← Volver</a>
		</div>
	</div>
	if prompt == nil {
		<div class="card">
			@EmptyState("Prompt no encontrado", "Este prompt no existe o no es visible para el usuario actual.")
		</div>
	} else {
		<div class="card">
			<div class="card-header">
				<div class="card-title">Metadatos</div>
			</div>
			<div class="table-wrapper">
				<table class="data-table">
					<tbody>
						<tr><th>ID Chunk</th><td><code>{ prompt.ChunkID }</code></td></tr>
						<tr><th>Sesión</th><td><a href={ templ.SafeURL("/dashboard/sessions/" + url.PathEscape(prompt.Project) + "/" + url.PathEscape(prompt.SessionID)) }>{ prompt.SessionID }</a></td></tr>
						<tr><th>Proyecto</th><td>{ prompt.Project }</td></tr>
						<tr><th>Creado</th><td>{ formatTimestamp(prompt.CreatedAt) }</td></tr>
					</tbody>
				</table>
			</div>
		</div>
		<div class="card">
			<div class="card-header">
				<div class="card-title">Contenido</div>
			</div>
			<div style="white-space:pre-wrap;font-size:0.92rem;line-height:1.65">
				@templ.Raw(renderStructuredContent(prompt.Content))
			</div>
		</div>
		if session != nil {
			<div class="card">
				<div class="card-header">
					<div class="card-title">Sesión vinculada</div>
				</div>
				<h3 style="margin:0 0 0.25rem;font-family:var(--font-sans);font-size:1rem"><a href={ templ.SafeURL("/dashboard/sessions/" + url.PathEscape(session.Project) + "/" + url.PathEscape(session.SessionID)) }>{ session.Project }</a></h3>
				<p class="muted" style="margin:0;font-size:0.85rem">Iniciada { formatTimestamp(session.StartedAt) }</p>
			</div>
		}
		if len(related) > 0 {
			<div class="card">
				<div class="card-header">
					<div class="card-title">Otros prompts de esta sesión</div>
				</div>
				@PromptsPartial(related, Pagination{})
			</div>
		}
	}
}

// ─── Phase 6: Projects Tab ──────────────────────────────────────────────────

// ProjectsPage renders the projects list view.
templ ProjectsPage(search string) {
	<div class="main-header">
		<div>
			<p class="section-kicker">OPERACIÓN</p>
			<h1>📁 Proyectos</h1>
			<p class="lead">Atlas de proyectos enrolados — sesiones, observaciones y prompts agregados por equipo.</p>
		</div>
	</div>

	<div class="card">
		<form>
			<label style="margin:0">
				<input
					id="project-search"
					type="search"
					name="q"
					placeholder="🔍 Buscar proyectos..."
					value={ search }
					hx-get="/dashboard/projects/list"
					hx-target="#projects-content"
					hx-swap="innerHTML"
					hx-trigger="keyup changed delay:300ms"
				/>
			</label>
		</form>
	</div>

	<div id="projects-content"
		hx-get="/dashboard/projects/list"
		hx-trigger="load"
		hx-swap="innerHTML"
		hx-include="#project-search">
		<p class="muted">Cargando...</p>
	</div>
}

// ProjectsListPartial renders the project cards grid, loaded via htmx.
// ADAPTED: ProjectStat -> DashboardProjectRow; ProjectSyncControl kept (now in integrated cloudstore).
// R4-3: HtmxPaginationBar added so users can navigate beyond the first page.
templ ProjectsListPartial(stats []cloudstore.DashboardProjectRow, controls map[string]cloudstore.ProjectSyncControl, pg Pagination) {
	if len(stats) == 0 {
		<div class="card">
			@EmptyState("Sin proyectos", "Ningún proyecto coincide con la búsqueda.")
		</div>
	} else {
		<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:1rem">
			for _, s := range stats {
				<a href={ templ.SafeURL("/dashboard/projects/" + url.PathEscape(s.Project)) } class="card" style="text-decoration:none;color:inherit;display:flex;flex-direction:column">
					<div style="display:flex;justify-content:space-between;align-items:flex-start;gap:0.5rem;margin-bottom:0.75rem">
						<h3 style="font-family:var(--font-display);font-size:1.1rem;margin:0">{ s.Project }</h3>
						if !projectControl(controls, s.Project).SyncEnabled {
							@StatusBadge("Pausado", "danger")
						} else {
							@StatusBadge("Activo", "success")
						}
					</div>
					<div style="display:grid;grid-template-columns:repeat(3,1fr);gap:0.5rem;margin-bottom:0.5rem">
						<div>
							<div class="stat-value" style="font-size:1.25rem">{ fmt.Sprint(s.Sessions) }</div>
							<div class="stat-label">Sesiones</div>
						</div>
						<div>
							<div class="stat-value" style="font-size:1.25rem">{ fmt.Sprint(s.Observations) }</div>
							<div class="stat-label">Obs.</div>
						</div>
						<div>
							<div class="stat-value" style="font-size:1.25rem">{ fmt.Sprint(s.Prompts) }</div>
							<div class="stat-label">Prompts</div>
						</div>
					</div>
					if !projectControl(controls, s.Project).SyncEnabled && projectControl(controls, s.Project).PausedReason != nil {
						<p class="muted" style="font-size:0.75rem;margin:0.5rem 0 0;padding-top:0.5rem;border-top:1px solid var(--border)">Pausado: { *projectControl(controls, s.Project).PausedReason }</p>
					}
				</a>
			}
		</div>
		@HtmxPaginationBar(pg, "/dashboard/projects/list", "#projects-content", "#project-search")
	}
}

// ProjectDetailPage renders the detail view for a single project.
// ADAPTED: ProjectStat -> DashboardProjectRow; ProjectSyncControl kept.
templ ProjectDetailPage(project string, stats *cloudstore.DashboardProjectRow, control *cloudstore.ProjectSyncControl) {
	<div class="main-header">
		<div>
			<p class="section-kicker">DETALLE PROYECTO</p>
			<h1>📁 { project }</h1>
			<p class="lead"><a href="/dashboard/projects">Proyectos</a> / { project }</p>
		</div>
		<div class="main-actions">
			if control != nil {
				if control.SyncEnabled {
					@StatusBadge("Sync On", "success")
				} else {
					@StatusBadge("Sync Pausado", "danger")
				}
			}
			<a href="/dashboard/projects" class="btn btn-outline">← Volver</a>
		</div>
	</div>

	if control != nil && !control.SyncEnabled {
		<div class="card" style="border-color:var(--destructive)">
			<div class="card-header">
				<div class="card-title">⚠️ Política de organización</div>
				<p class="card-description">Este proyecto fue pausado en el control plane de la nube.</p>
			</div>
			if control.PausedReason != nil {
				<p style="margin:0.25rem 0"><strong>Razón:</strong> { *control.PausedReason }</p>
			}
			if control.UpdatedBy != nil {
				<p style="margin:0.25rem 0"><strong>Actualizado por:</strong> { *control.UpdatedBy }</p>
			}
			if control.UpdatedAt != "" {
				<p style="margin:0.25rem 0"><strong>Actualizado:</strong> { formatTimestamp(control.UpdatedAt) }</p>
			}
		</div>
	}

	if stats != nil {
		<div class="stat-grid">
			<div class="stat-card">
				<div class="stat-label">Sesiones</div>
				<div class="stat-value">{ fmt.Sprint(stats.Sessions) }</div>
			</div>
			<div class="stat-card">
				<div class="stat-label">Observaciones</div>
				<div class="stat-value">{ fmt.Sprint(stats.Observations) }</div>
			</div>
			<div class="stat-card">
				<div class="stat-label">Prompts</div>
				<div class="stat-value">{ fmt.Sprint(stats.Prompts) }</div>
			</div>
		</div>
	}

	<div class="card">
		<div role="tablist" id="project-tabs" style="display:flex;flex-wrap:wrap;gap:0.4rem;margin-bottom:1rem">
			<button role="tab" aria-selected="true" class="btn btn-primary btn-sm active"
				hx-get={ fmt.Sprintf("/dashboard/projects/%s/observations", url.PathEscape(project)) }
				hx-target="#project-content"
				hx-swap="innerHTML"
				hx-on::after-request="document.querySelectorAll('#project-tabs [role=tab]').forEach(t=>{t.classList.remove('active','btn-primary');t.classList.add('btn-outline')});this.classList.remove('btn-outline');this.classList.add('active','btn-primary')">Observaciones</button>
			<button role="tab" aria-selected="false" class="btn btn-outline btn-sm"
				hx-get={ fmt.Sprintf("/dashboard/projects/%s/sessions", url.PathEscape(project)) }
				hx-target="#project-content"
				hx-swap="innerHTML"
				hx-on::after-request="document.querySelectorAll('#project-tabs [role=tab]').forEach(t=>{t.classList.remove('active','btn-primary');t.classList.add('btn-outline')});this.classList.remove('btn-outline');this.classList.add('active','btn-primary')">Sesiones</button>
			<button role="tab" aria-selected="false" class="btn btn-outline btn-sm"
				hx-get={ fmt.Sprintf("/dashboard/projects/%s/prompts", url.PathEscape(project)) }
				hx-target="#project-content"
				hx-swap="innerHTML"
				hx-on::after-request="document.querySelectorAll('#project-tabs [role=tab]').forEach(t=>{t.classList.remove('active','btn-primary');t.classList.add('btn-outline')});this.classList.remove('btn-outline');this.classList.add('active','btn-primary')">Prompts</button>
		</div>
		<div id="project-content"
			hx-get={ fmt.Sprintf("/dashboard/projects/%s/observations", url.PathEscape(project)) }
			hx-trigger="load"
			hx-swap="innerHTML">
			<p class="muted">Cargando...</p>
		</div>
	</div>
}

// ─── Phase 7: Contributors Tab ──────────────────────────────────────────────

// ContributorsListPartial renders the contributors table + HtmxPaginationBar only (no shell, no outer wrapper).
// R5-2: used by /dashboard/contributors/list so HTMX pagination works without full-page nav.
// R6-1: outer <div id="contributors-content"> removed — HTMX swaps innerHTML into the existing
//
//	shell div, so re-wrapping in the same ID would create duplicate IDs in the DOM.
templ ContributorsListPartial(contributors []cloudstore.DashboardContributorRow, pg Pagination) {
	if len(contributors) == 0 {
		@EmptyState("Sin colaboradores aún", "La actividad de los colaboradores aparecerá una vez que el equipo empiece a sincronizar.")
	} else {
		<div class="table-wrapper">
			<table class="data-table">
				<thead>
					<tr>
						<th>Colaborador</th>
						<th>Chunks</th>
						<th>Proyectos</th>
						<th>Último chunk</th>
					</tr>
				</thead>
				<tbody>
					for _, c := range contributors {
						<tr>
							<td><a href={ templ.SafeURL("/dashboard/contributors/" + url.PathEscape(c.CreatedBy)) }>{ c.CreatedBy }</a></td>
							<td>{ fmt.Sprint(c.Chunks) }</td>
							<td>{ fmt.Sprint(c.Projects) }</td>
							<td>{ formatTimestampStr(c.LastChunkAt) }</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
		@HtmxPaginationBar(pg, "/dashboard/contributors/list", "#contributors-content", "")
	}
}

// ContributorsPage renders the contributors list shell.
// R6-1: converted to hx-get/load pattern (mirrors ProjectsPage) — the inline table is removed.
// The outer #contributors-content div triggers an HTMX load of /dashboard/contributors/list.
templ ContributorsPage(search string) {
	<div class="main-header">
		<div>
			<p class="section-kicker">ADMINISTRACIÓN</p>
			<h1>👥 Colaboradores</h1>
			<p class="lead">Actividad por colaborador — chunks, proyectos y última sync.</p>
		</div>
	</div>

	<div class="card">
		<form>
			<label style="margin:0">
				<input
					id="contributor-search"
					type="search"
					name="q"
					placeholder="🔍 Buscar colaboradores..."
					value={ search }
					hx-get="/dashboard/contributors/list"
					hx-target="#contributors-content"
					hx-swap="innerHTML"
					hx-trigger="keyup changed delay:300ms"
				/>
			</label>
		</form>
	</div>

	<div id="contributors-content"
		hx-get="/dashboard/contributors/list"
		hx-trigger="load"
		hx-swap="innerHTML"
		hx-include="#contributor-search">
		<p class="muted">Cargando...</p>
	</div>
}

// ContributorDetailPage renders contributor detail.
// ADAPTED: ContributorStat -> DashboardContributorRow.
// R4-8: displayName parameter removed — it was passed but never used in the template body.
templ ContributorDetailPage(contributor *cloudstore.DashboardContributorRow, sessions []cloudstore.DashboardSessionRow, observations []cloudstore.DashboardObservationRow, prompts []cloudstore.DashboardPromptRow) {
	<div class="main-header">
		<div>
			<p class="section-kicker">DETALLE COLABORADOR</p>
			if contributor != nil {
				<h1>👤 { contributor.CreatedBy }</h1>
			} else {
				<h1>👤 Colaborador</h1>
			}
		</div>
		<div class="main-actions">
			<a href="/dashboard/contributors" class="btn btn-outline">← Volver</a>
		</div>
	</div>
	if contributor == nil {
		<div class="card">
			@EmptyState("Colaborador no encontrado", "Este colaborador no existe o está fuera de la vista de tu organización.")
		</div>
	} else {
		<div class="stat-grid">
			<a href={ templ.SafeURL("/dashboard/browser?q=" + url.QueryEscape(contributor.CreatedBy)) } class="stat-card" style="text-decoration:none;color:inherit">
				<div class="stat-label">Chunks</div>
				<div class="stat-value">{ fmt.Sprint(contributor.Chunks) }</div>
			</a>
			<a href={ templ.SafeURL("/dashboard/projects?q=" + url.QueryEscape(contributor.CreatedBy)) } class="stat-card" style="text-decoration:none;color:inherit">
				<div class="stat-label">Proyectos</div>
				<div class="stat-value">{ fmt.Sprint(contributor.Projects) }</div>
			</a>
			<div class="stat-card">
				<div class="stat-label">Último chunk</div>
				<div class="stat-value" style="font-size:1rem;font-family:var(--font-sans)">{ formatTimestampStr(contributor.LastChunkAt) }</div>
			</div>
		</div>

		<div class="card">
			<div class="card-header">
				<div class="card-title">Sesiones recientes</div>
			</div>
			@SessionsPartial(sessions, Pagination{})
		</div>
		<div class="card">
			<div class="card-header">
				<div class="card-title">Observaciones recientes</div>
			</div>
			@ObservationsPartial(observations, Pagination{})
		</div>
		<div class="card">
			<div class="card-header">
				<div class="card-title">Prompts recientes</div>
			</div>
			@PromptsPartial(prompts, Pagination{})
		</div>
	}
}

// ─── Phase 8: Admin Views ───────────────────────────────────────────────────

// adminNav renders the shared admin sub-navigation bar.
// active should be one of: "overview", "projects", "users", "health", "audit-log".
templ adminNav(active string) {
	<div class="admin-nav">
		if active == "overview" {
			<a href="/dashboard/admin" class="active">Resumen</a>
		} else {
			<a href="/dashboard/admin">Resumen</a>
		}
		if active == "projects" {
			<a href="/dashboard/admin/projects" class="active">Proyectos</a>
		} else {
			<a href="/dashboard/admin/projects">Proyectos</a>
		}
		if active == "users" {
			<a href="/dashboard/admin/users" class="active">Usuarios</a>
		} else {
			<a href="/dashboard/admin/users">Usuarios</a>
		}
		if active == "skills" {
			<a href="/dashboard/admin/skills" class="active">Skills</a>
		} else {
			<a href="/dashboard/admin/skills">Skills</a>
		}
		if active == "mcp" {
			<a href="/dashboard/admin/mcp" class="active">MCP & Tools</a>
		} else {
			<a href="/dashboard/admin/mcp">MCP & Tools</a>
		}
		if active == "health" {
			<a href="/dashboard/admin/health" class="active">Salud del Sistema</a>
		} else {
			<a href="/dashboard/admin/health">Salud del Sistema</a>
		}
		if active == "audit-log" {
			<a href="/dashboard/admin/audit-log" class="active">Bitácora de Auditoría</a>
		} else {
			<a href="/dashboard/admin/audit-log">Bitácora de Auditoría</a>
		}
	</div>
}

// AdminPage renders the admin dashboard landing with sub-navigation.
// ADAPTED: SystemHealthInfo -> DashboardSystemHealth; ProjectSyncControl kept.
templ AdminPage(health *cloudstore.DashboardSystemHealth, controls []cloudstore.ProjectSyncControl) {
	<div class="main-header">
		<div>
			<p class="section-kicker">ADMINISTRACIÓN</p>
			<h1>⚙️ Administración</h1>
			<p class="lead">Resumen del sistema, métricas globales y controles de operación.</p>
		</div>
	</div>

	<div class="card">
		@adminNav("overview")
	</div>

	if health != nil {
		<div class="stat-grid">
			<div class="stat-card">
				<div class="stat-label">Base de datos</div>
				<div class="stat-value" style="font-size:1rem;font-family:var(--font-sans)">
					if health.DBConnected {
						@StatusBadge("Conectada", "success")
					} else {
						@StatusBadge("Desconectada", "danger")
					}
				</div>
			</div>
			<div class="stat-card">
				<div class="stat-label">Colaboradores</div>
				<div class="stat-value">{ fmt.Sprint(health.Contributors) }</div>
			</div>
			<div class="stat-card">
				<div class="stat-label">Sesiones</div>
				<div class="stat-value">{ fmt.Sprint(health.Sessions) }</div>
			</div>
			<div class="stat-card">
				<div class="stat-label">Observaciones</div>
				<div class="stat-value">{ fmt.Sprint(health.Observations) }</div>
			</div>
			<div class="stat-card">
				<div class="stat-label">Prompts</div>
				<div class="stat-value">{ fmt.Sprint(health.Prompts) }</div>
			</div>
			<div class="stat-card">
				<div class="stat-label">Proyectos</div>
				<div class="stat-value">{ fmt.Sprint(health.Projects) }</div>
			</div>
			<div class="stat-card">
				<div class="stat-label">Proyectos pausados</div>
				<div class="stat-value">{ fmt.Sprint(countPausedProjects(controls)) }</div>
			</div>
		</div>
	}
}

// AdminProjectsPage renders organization-level project sync controls.
// ADAPTED: ProjectSyncControl kept (integrated cloudstore now has it).
templ AdminProjectsPage(controls []cloudstore.ProjectSyncControl) {
	<div class="main-header">
		<div>
			<p class="section-kicker">ADMINISTRACIÓN</p>
			<h1>📁 Controles de proyecto</h1>
			<p class="lead">Habilitá o pausá la sync por proyecto a nivel organización.</p>
		</div>
	</div>

	<div class="card">
		@adminNav("projects")
	</div>

	if len(controls) == 0 {
		<div class="card">
			@EmptyState("Sin proyectos gestionados", "Los proyectos aparecen aquí una vez que la nube recibe datos o entradas de política.")
		</div>
	} else {
		<div class="table-wrapper">
			<table class="data-table">
				<thead>
					<tr>
						<th>Proyecto</th>
						<th>Sync</th>
						<th>Razón</th>
						<th>Actualizado por</th>
						<th>Actualizado</th>
						<th>Acción</th>
					</tr>
				</thead>
				<tbody>
					for _, control := range controls {
						<tr>
							<td><a href={ templ.SafeURL("/dashboard/projects/" + url.PathEscape(control.Project)) }>{ control.Project }</a></td>
							<td>
								if control.SyncEnabled {
									@StatusBadge("On", "success")
								} else {
									@StatusBadge("Pausado", "danger")
								}
							</td>
							<td>
								if control.SyncEnabled {
									<span class="muted">—</span>
								} else if control.PausedReason != nil {
									{ *control.PausedReason }
								} else {
									<span class="muted">Sin razón</span>
								}
							</td>
							<td>
								if control.UpdatedBy != nil {
									{ *control.UpdatedBy }
								} else {
									<span class="muted">Sistema</span>
								}
							</td>
							<td>
								if control.UpdatedAt != "" {
									{ formatTimestamp(control.UpdatedAt) }
								} else {
									<span class="muted">Por defecto</span>
								}
							</td>
							<td>
								<form method="post" action={ templ.SafeURL("/dashboard/admin/projects/" + url.PathEscape(control.Project) + "/sync") } style="display:flex;gap:0.4rem;align-items:center;margin:0">
									<input type="text" name="reason" placeholder="Razón al pausar" value={ projectControlReasonValue(control) } style="margin:0;font-size:0.8rem;padding:0.35rem 0.5rem"/>
									if control.SyncEnabled {
										<input type="hidden" name="enabled" value="false"/>
										<button type="submit" class="btn btn-success btn-sm" hx-post={ "/dashboard/admin/projects/" + url.PathEscape(control.Project) + "/sync" } hx-include="closest form">On</button>
									} else {
										<input type="hidden" name="enabled" value="true"/>
										<button type="submit" class="btn btn-destructive btn-sm" hx-post={ "/dashboard/admin/projects/" + url.PathEscape(control.Project) + "/sync" } hx-include="closest form">Off</button>
									}
								</form>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}

// adminUserRow renderea una sola fila de usuario (reutilizable para HTMX outerHTML).
templ adminUserRow(u AdminUserView) {
	<tr id={ "user-row-" + u.UID }>
		<td>{ u.Email }</td>
		<td>{ u.Name }</td>
		<td>
			<div style="display:flex;flex-wrap:wrap;gap:0.25rem">
				for _, r := range AvailableRoles() {
					if userHasRole(u, r.Value) {
						<button hx-post={ "/dashboard/admin/users/" + u.UID + "/roles/" + r.Value + "/remove" } hx-target={ "#user-row-" + u.UID } hx-swap="outerHTML" class="btn btn-success btn-sm">{ r.Label } ✓</button>
					} else {
						<button hx-post={ "/dashboard/admin/users/" + u.UID + "/roles/" + r.Value + "/add" } hx-target={ "#user-row-" + u.UID } hx-swap="outerHTML" class="btn btn-outline btn-sm">+ { r.Label }</button>
					}
				}
			</div>
		</td>
		<td>
			if u.IsActive {
				<button hx-post={ "/dashboard/admin/users/" + u.UID + "/deactivate" } hx-target={ "#user-row-" + u.UID } hx-swap="outerHTML" class="btn btn-success btn-sm">Activo</button>
			} else {
				<button hx-post={ "/dashboard/admin/users/" + u.UID + "/activate" } hx-target={ "#user-row-" + u.UID } hx-swap="outerHTML" class="btn btn-outline btn-sm">Inactivo</button>
			}
		</td>
		<td>{ formatTimestampTime(u.CreatedAt) }</td>
		<td>
			<details>
				<summary style="cursor:pointer;font-size:0.85rem">Cambiar password</summary>
				<form hx-post={ "/dashboard/admin/users/" + u.UID + "/password" } hx-target="#admin-users-feedback" hx-swap="innerHTML" style="display:flex;gap:0.4rem;align-items:center;margin-top:0.5rem">
					<input type="password" name="password" placeholder="nueva password (≥8)" required minlength="8" style="margin:0;font-size:0.8rem"/>
					<button type="submit" class="btn btn-primary btn-sm">Set</button>
				</form>
			</details>
		</td>
	</tr>
}

// AdminUsersListPartial renderea solo la tabla de usuarios (sin shell).
templ AdminUsersListPartial(users []AdminUserView, errorMsg string) {
	if errorMsg != "" {
		<div class="login-error" role="alert">{ errorMsg }</div>
	}
	if len(users) == 0 {
		@EmptyState("Sin usuarios", "No hay usuarios registrados aún. Creá el primero con el formulario de arriba.")
	} else {
		<div class="table-wrapper">
			<table class="data-table">
				<thead>
					<tr>
						<th>Email</th>
						<th>Nombre</th>
						<th>Roles</th>
						<th>Activo</th>
						<th>Creado</th>
						<th>Acciones</th>
					</tr>
				</thead>
				<tbody>
					for _, u := range users {
						@adminUserRow(u)
					}
				</tbody>
			</table>
		</div>
	}
}

// AdminUsersPage renderea la página completa de admin users con form crear + tabla.
templ AdminUsersPage() {
	<div class="main-header">
		<div>
			<p class="section-kicker">ADMINISTRACIÓN</p>
			<h1>👥 Usuarios</h1>
			<p class="lead">Gestión de cuentas, roles y passwords del equipo.</p>
		</div>
	</div>

	<div class="card">
		@adminNav("users")
	</div>

	<div class="card">
		<div class="card-header">
			<div class="card-title">Crear usuario</div>
			<p class="card-description">Email + nombre + roles + password inicial.</p>
		</div>
		<form hx-post="/dashboard/admin/users/create" hx-target="#admin-users-content" hx-swap="innerHTML">
			<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:0.75rem">
				<label style="margin:0">
					Email
					<input type="email" name="email" placeholder="user@itechdev.com.mx" required/>
				</label>
				<label style="margin:0">
					Nombre
					<input type="text" name="name" placeholder="Nombre Completo"/>
				</label>
				<label style="margin:0">
					Password (≥8)
					<input type="password" name="password" required minlength="8"/>
				</label>
			</div>
			<fieldset style="margin-top:0.75rem;padding:0.75rem;border:1px solid var(--border);border-radius:var(--radius-md)">
				<legend style="padding:0 0.4rem;font-size:0.85rem;font-weight:500">Roles (uno o más)</legend>
				<div style="display:flex;flex-wrap:wrap;gap:0.75rem">
					for _, r := range AvailableRoles() {
						<label style="display:inline-flex;align-items:center;gap:0.25rem;margin:0">
							<input type="checkbox" name="roles" value={ r.Value } style="width:auto;margin:0"/>
							{ r.Label }
						</label>
					}
				</div>
			</fieldset>
			<button type="submit" class="btn btn-primary" style="margin-top:0.75rem">+ Crear usuario</button>
		</form>
		<div id="admin-users-feedback" class="muted" style="margin-top:0.5rem"></div>
	</div>

	<div class="card">
		<div class="card-header">
			<div class="card-title">Lista de usuarios</div>
		</div>
		<div id="admin-users-content"
			hx-get="/dashboard/admin/users/list"
			hx-trigger="load"
			hx-swap="innerHTML">
			<p class="muted">Cargando...</p>
		</div>
	</div>
}

// AdminHealthPage renders the system health detail view.
// ADAPTED: SystemHealthInfo -> DashboardSystemHealth.
templ AdminHealthPage(health *cloudstore.DashboardSystemHealth) {
	<div class="main-header">
		<div>
			<p class="section-kicker">ADMINISTRACIÓN</p>
			<h1>💚 Salud del sistema</h1>
			<p class="lead">Estado de la base de datos y métricas globales del sistema.</p>
		</div>
	</div>

	<div class="card">
		@adminNav("health")
	</div>

	if health != nil {
		<div class="card">
			<div class="card-header">
				<div class="card-title">Métricas del sistema</div>
			</div>
			<div class="table-wrapper">
				<table class="data-table">
					<tbody>
						<tr>
							<th>Base de datos</th>
							<td>
								if health.DBConnected {
									@StatusBadge("Conectada", "success")
								} else {
									@StatusBadge("Desconectada", "danger")
								}
							</td>
						</tr>
						<tr>
							<th>Proyectos</th>
							<td>{ fmt.Sprint(health.Projects) }</td>
						</tr>
						<tr>
							<th>Colaboradores</th>
							<td>{ fmt.Sprint(health.Contributors) }</td>
						</tr>
						<tr>
							<th>Sesiones</th>
							<td>{ fmt.Sprint(health.Sessions) }</td>
						</tr>
						<tr>
							<th>Observaciones</th>
							<td>{ fmt.Sprint(health.Observations) }</td>
						</tr>
						<tr>
							<th>Prompts</th>
							<td>{ fmt.Sprint(health.Prompts) }</td>
						</tr>
						<tr>
							<th>Total Chunks</th>
							<td>{ fmt.Sprint(health.Chunks) }</td>
						</tr>
					</tbody>
				</table>
			</div>
		</div>
	} else {
		<div class="card">
			@EmptyState("No disponible", "No se pudo obtener la información de salud del sistema.")
		</div>
	}
}

// AdminForbidden renders the 403 page for non-admin users.
templ AdminForbidden() {
	<div class="main-header">
		<div>
			<p class="section-kicker">ACCESO DENEGADO</p>
			<h1>🚫 Sin permisos</h1>
		</div>
	</div>
	<div class="card">
		@EmptyState("Acceso denegado", "No tenés privilegios de administrador.")
	</div>
}

// AdminSyncToggleFormPartial renders the HTMX-driven toggle form for a single project.
templ AdminSyncToggleFormPartial(control cloudstore.ProjectSyncControl) {
	<form method="post" action={ templ.SafeURL("/dashboard/admin/projects/" + url.PathEscape(control.Project) + "/sync") } style="display:flex;gap:0.4rem;align-items:center;margin:0">
		<input type="text" name="reason" placeholder="Razón al pausar" value={ projectControlReasonValue(control) } style="margin:0;font-size:0.8rem;padding:0.35rem 0.5rem"/>
		if control.SyncEnabled {
			<input type="hidden" name="enabled" value="false"/>
			<button type="submit" class="btn btn-success btn-sm" hx-post={ "/dashboard/admin/projects/" + url.PathEscape(control.Project) + "/sync" } hx-include="closest form">On</button>
		} else {
			<input type="hidden" name="enabled" value="true"/>
			<button type="submit" class="btn btn-destructive btn-sm" hx-post={ "/dashboard/admin/projects/" + url.PathEscape(control.Project) + "/sync" } hx-include="closest form">Off</button>
		}
	</form>
}

// SessionDetailPage renders a connected session detail surface.
// ADAPTED: CloudSession -> DashboardSessionRow; CloudObservation -> DashboardObservationRow; CloudPrompt -> DashboardPromptRow.
templ SessionDetailPage(session *cloudstore.DashboardSessionRow, observations []cloudstore.DashboardObservationRow, prompts []cloudstore.DashboardPromptRow) {
	<div class="main-header">
		<div>
			<p class="section-kicker">SESSION TRACE</p>
			if session != nil {
				<h1>🧵 { session.Project }</h1>
				<p class="lead">Sesión <code>{ session.SessionID }</code></p>
			} else {
				<h1>🧵 Sesión</h1>
			}
		</div>
		<div class="main-actions">
			<a href="/dashboard/browser" class="btn btn-outline">← Volver</a>
		</div>
	</div>
	if session == nil {
		<div class="card">
			@EmptyState("Sesión no encontrada", "Esta sesión no existe o ya no es visible para el usuario actual.")
		</div>
	} else {
		<div class="stat-grid">
			<div class="stat-card">
				<div class="stat-label">Observaciones</div>
				<div class="stat-value">{ fmt.Sprint(len(observations)) }</div>
			</div>
			<div class="stat-card">
				<div class="stat-label">Prompts</div>
				<div class="stat-value">{ fmt.Sprint(len(prompts)) }</div>
			</div>
			<div class="stat-card">
				<div class="stat-label">Iniciado</div>
				<div class="stat-value" style="font-size:1rem;font-family:var(--font-sans)">{ formatTimestamp(session.StartedAt) }</div>
			</div>
		</div>

		<div class="card">
			<div class="card-header">
				<div class="card-title">Metadatos de la sesión</div>
			</div>
			<div class="table-wrapper">
				<table class="data-table">
					<tbody>
						<tr><th>ID Sesión</th><td><code>{ session.SessionID }</code></td></tr>
						<tr><th>Proyecto</th><td><a href={ templ.SafeURL("/dashboard/projects/" + url.PathEscape(session.Project)) }>{ session.Project }</a></td></tr>
						<tr><th>Directorio</th><td><code>{ session.Directory }</code></td></tr>
						<tr><th>Iniciado</th><td>{ formatTimestamp(session.StartedAt) }</td></tr>
						<tr>
							<th>Terminó</th>
							<td>
								if session.EndedAt != "" {
									{ formatTimestamp(session.EndedAt) }
								} else {
									@StatusBadge("Activa", "success")
								}
							</td>
						</tr>
						<tr>
							<th>Resumen</th>
							<td>
								if session.Summary != "" {
									{ session.Summary }
								} else {
									<span class="muted">Sin resumen de sesión.</span>
								}
							</td>
						</tr>
					</tbody>
				</table>
			</div>
		</div>

		<div class="card">
			<div class="card-header">
				<div class="card-title">Observaciones en esta sesión</div>
				<p class="card-description">{ fmt.Sprint(len(observations)) } observaciones registradas.</p>
			</div>
			@ObservationsPartial(observations, Pagination{})
		</div>

		<div class="card">
			<div class="card-header">
				<div class="card-title">Prompts en esta sesión</div>
				<p class="card-description">{ fmt.Sprint(len(prompts)) } prompts registrados.</p>
			</div>
			@PromptsPartial(prompts, Pagination{})
		</div>
	}
}

// ObservationDetailPage renders the full observation payload with session context.
// ADAPTED: CloudObservation -> DashboardObservationRow; CloudSession -> DashboardSessionRow.
templ ObservationDetailPage(observation *cloudstore.DashboardObservationRow, session *cloudstore.DashboardSessionRow, related []cloudstore.DashboardObservationRow) {
	<div class="main-header">
		<div>
			<p class="section-kicker">DETALLE OBSERVACIÓN</p>
			if observation != nil {
				<h1>🔎 { observation.Title }</h1>
				<div style="margin-top:0.5rem;display:flex;flex-wrap:wrap;gap:0.4rem">
					@StatusBadge(observation.Type, typeBadgeVariant(observation.Type))
					@StatusBadge(observation.Project, "muted")
				</div>
			} else {
				<h1>🔎 Observación</h1>
			}
		</div>
		<div class="main-actions">
			<a href="/dashboard/browser" class="btn btn-outline">← Volver</a>
		</div>
	</div>
	if observation == nil {
		<div class="card">
			@EmptyState("Observación no encontrada", "Esta observación no existe o ya no es visible para el usuario actual.")
		</div>
	} else {
		<div class="card">
			<div class="card-header">
				<div class="card-title">Metadatos</div>
			</div>
			<div class="table-wrapper">
				<table class="data-table">
					<tbody>
						<tr><th>ID Chunk</th><td><code>{ observation.ChunkID }</code></td></tr>
						<tr><th>Sesión</th><td><a href={ templ.SafeURL("/dashboard/sessions/" + url.PathEscape(observation.Project) + "/" + url.PathEscape(observation.SessionID)) }>{ observation.SessionID }</a></td></tr>
						<tr><th>Creado</th><td>{ formatTimestamp(observation.CreatedAt) }</td></tr>
						<tr>
							<th>Herramienta</th>
							<td>
								if observation.ToolName != "" {
									{ observation.ToolName }
								} else {
									<span class="muted">Desconocida</span>
								}
							</td>
						</tr>
						<tr>
							<th>Topic Key</th>
							<td>
								if observation.TopicKey != "" {
									<code>{ observation.TopicKey }</code>
								} else {
									<span class="muted">Ninguno</span>
								}
							</td>
						</tr>
					</tbody>
				</table>
			</div>
		</div>

		<div class="card">
			<div class="card-header">
				<div class="card-title">Contenido</div>
			</div>
			<div style="white-space:pre-wrap;font-size:0.92rem;line-height:1.65">
				@templ.Raw(renderStructuredContent(observation.Content))
			</div>
		</div>

		if session != nil {
			<div class="card">
				<div class="card-header">
					<div class="card-title">Sesión vinculada</div>
				</div>
				<h3 style="margin:0 0 0.25rem;font-family:var(--font-sans);font-size:1rem"><a href={ templ.SafeURL("/dashboard/sessions/" + url.PathEscape(session.Project) + "/" + url.PathEscape(session.SessionID)) }>{ session.Project }</a></h3>
				<p class="muted" style="margin:0 0 0.5rem;font-size:0.85rem">Iniciada { formatTimestamp(session.StartedAt) }</p>
				if session.Summary != "" {
					<p style="margin:0">{ session.Summary }</p>
				}
			</div>
		}

		if len(related) > 0 {
			<div class="card">
				<div class="card-header">
					<div class="card-title">Más de esta sesión</div>
				</div>
				@ObservationsPartial(related, Pagination{})
			</div>
		}
	}
}

// ─── Phase 9: Audit Log Admin Views ─────────────────────────────────────────

// AdminAuditLogPage renders the admin audit log shell page.
// The HTMX container triggers loading the list partial on page load. REQ-408.
// JW2: buildAuditListURL embeds active filter params into the initial hx-get URL
// so that deep-linking /dashboard/admin/audit-log?contributor=alice preserves filters.
templ AdminAuditLogPage(displayName string, filter cloudstore.AuditFilter) {
	<div class="main-header">
		<div>
			<p class="section-kicker">ADMINISTRACIÓN</p>
			<h1>📋 Bitácora de Auditoría</h1>
			<p class="lead">Eventos del sistema con filtros por colaborador, proyecto, resultado y rango de fechas.</p>
		</div>
	</div>

	<div class="card">
		@adminNav("audit-log")
	</div>

	<div id="audit-log-content"
		hx-get={ buildAuditListURL(filter) }
		hx-trigger="load"
		hx-swap="innerHTML">
		<p class="muted">Cargando bitácora...</p>
	</div>
}

// AdminAuditLogListPartial renders the audit log table with filters and pagination. REQ-409, REQ-410.
templ AdminAuditLogListPartial(entries []cloudstore.DashboardAuditRow, pg Pagination, filter cloudstore.AuditFilter) {
	<div class="card">
		<div class="card-header">
			<div class="card-title">Filtros</div>
		</div>
		<form method="get" action="/dashboard/admin/audit-log/list"
			hx-get="/dashboard/admin/audit-log/list"
			hx-target="#audit-log-content"
			hx-swap="innerHTML"
			hx-trigger="submit">
			<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:0.5rem">
				<label style="margin:0">
					<input id="audit-contributor" type="text" name="contributor" placeholder="Colaborador" value={ filter.Contributor }/>
				</label>
				<label style="margin:0">
					<input id="audit-project" type="text" name="project" placeholder="Proyecto" value={ filter.Project }/>
				</label>
				<label style="margin:0">
					<select id="audit-outcome" name="outcome">
						<option value="">Todos los resultados</option>
						if filter.Outcome == cloudstore.AuditOutcomeRejectedProjectPaused {
							<option value={ cloudstore.AuditOutcomeRejectedProjectPaused } selected>Rejected (Paused)</option>
						} else {
							<option value={ cloudstore.AuditOutcomeRejectedProjectPaused }>Rejected (Paused)</option>
						}
					</select>
				</label>
				<label style="margin:0">
					<input id="audit-from" type="text" name="from" placeholder="Desde (RFC3339)" value={ auditTimeValue(filter.OccurredAtFrom) }/>
				</label>
				<label style="margin:0">
					<input id="audit-to" type="text" name="to" placeholder="Hasta (RFC3339)" value={ auditTimeValue(filter.OccurredAtTo) }/>
				</label>
			</div>
			<button type="submit" class="btn btn-primary btn-sm" style="margin-top:0.5rem">Filtrar</button>
		</form>
	</div>
	if len(entries) == 0 {
		<div class="card">
			@EmptyState("Sin entradas", "Ninguna entrada de la bitácora coincide con el filtro actual.")
		</div>
	} else {
		<div class="table-wrapper">
			<table class="data-table">
				<thead>
					<tr>
						<th>Tiempo</th>
						<th>Colaborador</th>
						<th>Proyecto</th>
						<th>Acción</th>
						<th>Resultado</th>
						<th>Entradas</th>
						<th>Razón</th>
					</tr>
				</thead>
				<tbody>
					for _, entry := range entries {
						<tr>
							<td>{ formatTimestampStr(entry.OccurredAt) }</td>
							<td>{ entry.Contributor }</td>
							<td>{ entry.Project }</td>
							<td>{ entry.Action }</td>
							<td>{ entry.Outcome }</td>
							<td>{ fmt.Sprint(entry.EntryCount) }</td>
							<td>{ entry.ReasonCode }</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
		@HtmxPaginationBar(pg, "/dashboard/admin/audit-log/list", "#audit-log-content", "#audit-contributor, #audit-project, #audit-outcome, #audit-from, #audit-to")
	}
}
