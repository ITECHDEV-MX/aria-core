package dashboard

import "strings"

// AyudaPage — guía de uso completa de ARIA Core para el equipo iTechDev.
// Actualizada hasta wave 8 (knowledge base + DOCX export + project mgmt).
templ AyudaPage(roles []string) {
	<style>
		.ayuda { max-width: 960px; margin: 0 auto; padding: 1.5rem; }
		.ayuda h1 { font-size: 2.2rem; margin: 0 0 0.5rem; }
		.ayuda h2 { margin-top: 2.5rem; padding-bottom: 0.5rem; border-bottom: 2px solid var(--border); color: var(--foreground); }
		.ayuda h3 { margin-top: 1.5rem; color: var(--foreground); }
		.ayuda h4 { margin-top: 1rem; color: var(--muted-foreground); }
		.ayuda .lead { font-size: 1.1rem; color: var(--muted-foreground); margin-bottom: 2rem; }
		.ayuda .toc { background: var(--muted); padding: 1.25rem 1.5rem; border-radius: var(--radius-lg); margin-bottom: 2rem; }
		.ayuda .toc h3 { margin: 0 0 0.5rem; font-size: 0.85rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--muted-foreground); }
		.ayuda .toc ol { margin: 0; padding-left: 1.5rem; columns: 2; column-gap: 2rem; }
		.ayuda .toc a { color: var(--primary); text-decoration: none; }
		.ayuda .toc a:hover { text-decoration: underline; }
		.ayuda .benefit { background: var(--card); border-left: 3px solid var(--success); padding: 0.85rem 1rem; margin: 0.6rem 0; border-radius: var(--radius-md); }
		.ayuda .benefit strong { color: var(--accent); }
		.ayuda .warning { background: var(--card); border-left: 3px solid var(--warning); padding: 0.85rem 1rem; margin: 0.6rem 0; border-radius: var(--radius-md); }
		.ayuda .important { background: var(--card); border-left: 3px solid var(--destructive); padding: 0.85rem 1rem; margin: 0.6rem 0; border-radius: var(--radius-md); }
		.ayuda .step { background: var(--muted); padding: 0.75rem 1rem; border-radius: var(--radius-md); margin: 0.5rem 0; }
		.ayuda .step-num { display: inline-block; width: 1.6rem; height: 1.6rem; background: var(--primary); color: var(--primary-foreground); border-radius: 50%; text-align: center; line-height: 1.6rem; font-weight: bold; margin-right: 0.5rem; }
		.ayuda pre { background: var(--card); padding: 1rem; border-radius: var(--radius-md); overflow-x: auto; font-size: 0.85rem; line-height: 1.5; border: 1px solid var(--border); }
		.ayuda code { background: var(--muted); padding: 0.1rem 0.35rem; border-radius: var(--radius-sm); font-size: 0.88rem; color: var(--accent); }
		.ayuda pre code { background: transparent; padding: 0; color: inherit; }
		.ayuda table { width: 100%; border-collapse: collapse; margin: 1rem 0; }
		.ayuda th, .ayuda td { padding: 0.55rem 0.75rem; text-align: left; border: 1px solid var(--border); vertical-align: top; }
		.ayuda th { background: var(--muted); color: var(--foreground); font-weight: 600; }
		.ayuda .role-badge { display: inline-block; padding: 0.2rem 0.55rem; border-radius: var(--radius-sm); font-size: 0.75rem; margin-right: 0.3rem; font-weight: 600; }
		.ayuda .role-admin { background: oklch(0.45 0.18 25); color: #fff; }
		.ayuda .role-dev { background: oklch(0.5 0.15 240); color: #fff; }
		.ayuda .role-cotizador { background: oklch(0.5 0.15 155); color: #fff; }
		.ayuda .role-project_admin { background: oklch(0.55 0.15 50); color: #fff; }
		.ayuda .role-agent { background: oklch(0.55 0.18 290); color: #fff; }
		.ayuda .module-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 0.75rem; margin: 1rem 0; }
		.ayuda .module-card { background: var(--card); border: 1px solid var(--border); border-radius: var(--radius-md); padding: 1rem; }
		.ayuda .module-card h4 { margin: 0 0 0.4rem; }
		.ayuda .module-card p { margin: 0; font-size: 0.85rem; color: var(--muted-foreground); }
	</style>

	<section class="ayuda">
		<p class="section-kicker">GUÍA DE USO · v2026.04 (wave 8)</p>
		<h1>ARIA Core — guía operativa</h1>
		<p class="lead">Plataforma central iTechDev: memoria + skills + cotizaciones + bóveda de secretos + mini-Notion + project management + chat IA. Esta guía explica qué hace, cómo se usa y qué tenés disponible según tu rol.</p>

		<div class="toc">
			<h3>Contenido</h3>
			<ol>
				<li><a href="#que-es">¿Qué es ARIA Core?</a></li>
				<li><a href="#pilares">Los 3 pilares + bóveda</a></li>
				<li><a href="#modulos">Módulos disponibles</a></li>
				<li><a href="#setup">Setup primer login</a></li>
				<li><a href="#mcp">MCP — Claude con tu memoria</a></li>
				<li><a href="#workflow">Workflow diario</a></li>
				<li><a href="#cotizador">Cotizador inteligente</a></li>
				<li><a href="#vault">Bóveda de secretos</a></li>
				<li><a href="#pages">Mini-Notion</a></li>
				<li><a href="#projects">Project mgmt + GitHub</a></li>
				<li><a href="#privacy">Privacy del cliente</a></li>
				<li><a href="#cuenta">Mi cuenta</a></li>
				<li><a href="#roles">Roles y permisos</a></li>
				<li><a href="#cli">CLI</a></li>
				<li><a href="#faq">FAQ</a></li>
			</ol>
		</div>

		<h2 id="que-es">1. ¿Qué es ARIA Core?</h2>
		<p>ARIA Core es la <strong>plataforma central de iTechDev</strong> que combina memoria, knowledge, cotizaciones, gestión de proyectos y bóveda de secretos en un solo sistema. Accesible desde:</p>
		<ul>
			<li><strong>Dashboard web</strong> — <code>https://ariacore.itechdev.com.mx</code></li>
			<li><strong>Claude Desktop / Code / Cursor</strong> — vía MCP con 40+ tools</li>
			<li><strong>CLI</strong> — binario <code>aria-core</code> en tu Mac/Linux</li>
			<li><strong>API REST</strong> — endpoints <code>/v1/memory</code>, <code>/v1/cotizador</code>, <code>/v1/vault</code>, <code>/v1/recipes</code>, <code>/v1/projects</code></li>
			<li><strong>Z.A.R.A. (Hermes agent)</strong> — secretaria IA de JC, usa ARIA via MCP</li>
		</ul>

		<h2 id="pilares">2. Los 3 pilares + bóveda de secretos</h2>
		<p>ARIA no es "otro Notion". Es <strong>proxy inteligente entre dev y Claude + bóveda del cliente + memoria viva del equipo</strong>:</p>

		<div class="benefit"><strong>Pilar 1 · Contexto del dev</strong> — cockpit personal en <code>/dashboard/me</code> con sesiones abiertas, heatmap, timeline, tareas asignadas. Resume-from-interrupt.</div>
		<div class="benefit"><strong>Pilar 2 · Claude Max bien usado</strong> — skills + memoria del lado de ARIA, no de Claude. Token budget manager. Skill effectiveness telemetry. <strong>VPS tiene su propia Max sub</strong> que ARIA usa via channel <code>claude-max-vps</code> — sin tocar tu cuota personal.</div>
		<div class="benefit"><strong>Pilar 3 · Bóveda del cliente</strong> — data sensible jamás llega a Claude/OpenAI cruda. Scrub con placeholders <code>[CLIENT-X]</code>, audit log inmutable, <code>confidential</code> ruta a Gemma local — nunca sale del VPS.</div>
		<div class="benefit"><strong>Bóveda de secretos</strong> — credenciales cifradas AES-256-GCM con per-cliente HKDF. Claude USA secrets sin verlos vía <code>aria_vault_use_in_cmd</code>.</div>

		<h2 id="modulos">3. Módulos disponibles</h2>
		<div class="module-grid">
			<div class="module-card"><h4>💡 Memoria</h4><p>Observations + sessions + skills + recipes. FTS español accent-insensitive. Multi-scope.</p></div>
			<div class="module-card"><h4>💼 Cotizador</h4><p>Leads, RFPs, quotes con templates. Histórico aprovechable.</p></div>
			<div class="module-card"><h4>💬 Quote-chat</h4><p>Cotización con chat IA: subís RFP, conversás, ARIA arma la propuesta. PII scrub automático.</p></div>
			<div class="module-card"><h4>🔒 Vault</h4><p>Secrets cifrados + ACL granular + audit log inmutable.</p></div>
			<div class="module-card"><h4>📄 Pages (mini-Notion)</h4><p>Páginas jerárquicas, attachments, databases inline (Table/Kanban/Gallery), comments + @mentions.</p></div>
			<div class="module-card"><h4>📁 Project Management</h4><p>Crear proyecto → auto-repo GitHub privado → tasks Kanban → knowledge per task.</p></div>
			<div class="module-card"><h4>🛡️ Redactor PII</h4><p>Scrubbing pre-LLM con tokens determinísticos. 4 niveles sensitivity.</p></div>
			<div class="module-card"><h4>📈 ROI Dashboard</h4><p>TTC/RDR/CWR/SVR/DTT — ahorro tiempo+costo medible vs baseline.</p></div>
			<div class="module-card"><h4>📋 Recipe runner</h4><p>Workflows ejecutables (deploy, backup, onboard) con telemetría.</p></div>
			<div class="module-card"><h4>🪝 Auto-capture</h4><p>Git hooks + CI integration + Claude exit detection — captura pasiva.</p></div>
			<div class="module-card"><h4>📊 Personal cockpit</h4><p>Tu actividad, sesiones, mis tareas asignadas, heatmap.</p></div>
			<div class="module-card"><h4>📚 Knowledge base central</h4><p>Repo único con PRDs/historias/cotizaciones .docx organizadas por proyecto.</p></div>
		</div>

		<h2 id="setup">4. Setup primer login</h2>
		<div class="step"><span class="step-num">1</span><strong>Abrí el welcome email</strong> con tus credenciales temporales.</div>
		<div class="step"><span class="step-num">2</span><strong>Login</strong> en <code>https://ariacore.itechdev.com.mx</code></div>
		<div class="step"><span class="step-num">3</span><strong>Cambiá tu password</strong> en <a href="/dashboard/me/security">Mi cuenta · Seguridad</a></div>
		<div class="step"><span class="step-num">4</span><strong>Completá tu perfil</strong> en <a href="/dashboard/me/profile">Mi cuenta · Perfil</a></div>
		<div class="step"><span class="step-num">5</span><strong>Configurá notificaciones</strong> en <a href="/dashboard/me/notifications">Mi cuenta · Notificaciones</a></div>
		<div class="step"><span class="step-num">6</span><strong>Instalá el binario y configurá MCP</strong> (siguiente sección)</div>

		<h2 id="mcp">5. MCP — Claude con tu memoria</h2>
		<p>El protocolo MCP permite que Claude Desktop/Code/Cursor accedan a 40+ tools de ARIA: buscar memoria, guardar observaciones, ejecutar recipes, usar secretos sin verlos, crear PRDs, asignar tareas.</p>

		<h4>Configurar Claude Desktop</h4>
		<p>Editá <code>~/Library/Application Support/Claude/claude_desktop_config.json</code>:</p>
		<pre><code>{ ayudaMCPConfig() }</code></pre>
		<p>Reiniciá Claude Desktop. Vas a ver los tools disponibles.</p>

		<h4>Tools clave</h4>
		<table>
			<thead><tr><th>Tool</th><th>Qué hace</th></tr></thead>
			<tbody>
				<tr><td><code>aria_session_start</code></td><td>Inicia sesión + retorna auto-contexto (canon obs + skills + recipes relevantes)</td></tr>
				<tr><td><code>aria_search</code></td><td>Busca en memoria con FTS + token budget. Respeta scrub PII para client_knowledge</td></tr>
				<tr><td><code>aria_save</code></td><td>Guarda observation con sensitivity auto-inferida</td></tr>
				<tr><td><code>aria_get_skills</code></td><td>Skills filtrados por stack + reranking por effectiveness</td></tr>
				<tr><td><code>aria_recipe_run</code></td><td>Ejecuta workflow con telemetría (dry-run support)</td></tr>
				<tr><td><code>aria_vault_use_in_cmd</code></td><td>Ejecuta comando local con secret inyectado, output enmascarado</td></tr>
				<tr><td><code>aria_page_create</code></td><td>Crea página (PRD, ADR, etc) en mini-Notion</td></tr>
				<tr><td><code>aria_task_create</code></td><td>Crea task en proyecto + asigna miembro</td></tr>
				<tr><td><code>cotizador_chat_send</code></td><td>Mensaje al chat de quote — ARIA arma propuesta iterativa</td></tr>
				<tr><td><code>aria_session_summary</code></td><td><strong>Cerrá tu sesión con esto</strong> al terminar — captura aprendizajes</td></tr>
			</tbody>
		</table>

		<div class="important">
			⚠️ <strong>Skill obligatorio</strong>: Cualquier sesión Claude en proyecto iTechDev DEBE seguir el protocolo en <code>~/.claude/skills/aria-mcp-protocol/SKILL.md</code>. Sin ese protocolo, ARIA es un wiki ignorado.
		</div>

		<h2 id="workflow">6. Workflow diario</h2>

		<h3>Mañana — al arrancar</h3>
		<ol>
			<li>Abrí <a href="/dashboard/me">Mi actividad</a> — ves sesiones zombi, tareas asignadas, heatmap.</li>
			<li>Cerrá sesiones zombi con resume + summary o close.</li>
			<li>Si tenés tareas asignadas, click → te lleva al proyecto.</li>
		</ol>

		<h3>Durante el trabajo</h3>
		<ol>
			<li>Abrí Claude Code en el repo. ARIA aparece en tools si configuraste MCP.</li>
			<li>Claude llama <code>aria_session_start</code> auto al inicio (si tenés el skill).</li>
			<li>Antes de investigar: <code>aria_search "tema"</code> — quizás ya está la respuesta.</li>
			<li>Cuando tomás una decisión técnica no obvia: <code>aria_save type=decision</code></li>
			<li>Al terminar: <code>aria_session_summary</code>. Sin esto, las decisiones se pierden.</li>
		</ol>

		<h2 id="cotizador">7. Cotizador inteligente</h2>
		<p>Si tenés rol <strong>cotizador</strong> o <strong>admin</strong>, módulo en <a href="/dashboard/cotizador">/dashboard/cotizador</a>:</p>

		<h3>Flujo IA — quote-chat (recomendado)</h3>
		<ol>
			<li>Click <strong>"💬 Nueva cotización con IA"</strong></li>
			<li>Setup: lead + tipo + upload RFP (PDF/DOCX)</li>
			<li>Chat split-pane: izq Claude, der quote en construcción live</li>
			<li>Iterás: "agregame pricing más agresivo", "enfatizá continuidad"</li>
			<li>ARIA scrub PII <strong>antes</strong> de mandar a Claude (placeholders), expand al recibir</li>
			<li>Claude Max VPS responde — no consume tu cuota personal</li>
			<li>Finalizar → <strong>"📄 Descargar .docx"</strong> con formato iTechDev (pandoc)</li>
			<li><strong>"📧 Email cliente"</strong> — modal preview obligatorio antes de send</li>
		</ol>

		<div class="benefit"><strong>Tiempo cotización</strong>: de 3-4h manual a 30-40min con quote-chat.</div>

		<h2 id="vault">8. Bóveda de secretos</h2>
		<p>El vault encripta credenciales con AES-256-GCM. <a href="/dashboard/vault">/dashboard/vault</a> (admin only).</p>
		<p>Categorías: <code>db_password</code> · <code>api_token</code> · <code>ssh_key</code> · <code>cert</code> · <code>env</code> · <code>webhook</code> · <code>generic</code></p>

		<h3>Crear un secret</h3>
		<pre><code>echo "MI_PASSWORD_SECRETO" | aria-core vault create \
  --name=DB_PROD_PARK --category=db_password \
  --scope=client_knowledge --client=&lt;CLIENT_UUID&gt; \
  --value-from-stdin</code></pre>

		<h3>Usar desde Claude (sin verlo)</h3>
		<p>Claude llama <code>aria_vault_use_in_cmd</code>. ARIA inyecta el secret en env del subprocess y devuelve stdout enmascarado como <code>&lt;&lt;MASKED:DB_PROD_PARK&gt;&gt;</code>. <strong>Claude jamás ve el valor real.</strong></p>

		<h2 id="pages">9. Mini-Notion (pages + databases)</h2>
		<p><a href="/dashboard/pages">/dashboard/pages</a> — wiki interno con jerarquía + markdown editor + 5 templates builtin (PRD, Incident, 1-1, ADR, Cliente Onboarding).</p>
		<ul>
			<li><strong>Tree view</strong> sidebar drag-to-reorder</li>
			<li><strong>Editor markdown</strong> con preview live</li>
			<li><strong>Cmd+K</strong> en cualquier página → search across pages + obs + skills + recipes + leads + quotes</li>
			<li><strong>Attachments</strong> con thumbnails async, MIME whitelist, dedup sha256</li>
			<li><strong>Public share links</strong> con expiry + password</li>
			<li><strong>Inline databases</strong> 11 prop types, 4 views (Table/Kanban/Gallery/List)</li>
			<li><strong>Comments threading</strong> + @mentions con email</li>
			<li><strong>Versionado</strong> — cada save crea revisión</li>
		</ul>

		<h2 id="projects">10. Project management + GitHub</h2>
		<p>(<strong>Wave 7 + 8</strong>) En <a href="/dashboard/projects/team">/dashboard/projects/team</a>:</p>
		<ol>
			<li>Click <strong>"Nuevo proyecto"</strong> → form con nombre, descripción, cliente opcional</li>
			<li>ARIA auto-crea <strong>repo privado</strong> bajo <code>ITECHDEV-MX/&lt;slug&gt;</code> con README estándar iTechDev</li>
			<li>Invitar miembros (existentes o magic-link a nuevos). Roles: owner/lead/member/viewer</li>
			<li><strong>PRDs y historias</strong> en mini-Notion — auto-commit a repo central <code>team-knowledge-base/proyectos/&lt;slug&gt;/prds/</code></li>
			<li><strong>Tasks Kanban</strong>: 4 columnas drag-drop, asignar miembros, due dates, priority</li>
			<li><strong>Mis tareas asignadas</strong> aparecen en cockpit personal</li>
			<li>Al cerrar task: <strong>knowledge capture automático</strong> — observaciones del rango + sesiones Claude Code + commits del dev</li>
		</ol>

		<h3>Repo central de knowledge</h3>
		<p>Un repo único <code>ITECHDEV-MX/team-knowledge-base</code>:</p>
		<pre><code>team-knowledge-base/
├── README.md  (índice auto-mantenido)
├── proyectos/
│   ├── &lt;slug&gt;/
│   │   ├── README.md
│   │   ├── prds/
│   │   ├── historias/
│   │   └── cotizaciones/
│   │       └── ITD-2026-XXX-001/
│   │           ├── propuesta.docx
│   │           ├── propuesta.md
│   │           └── metadata.json
└── plantillas/</code></pre>

		<h2 id="privacy">11. Privacy del cliente — 4 capas</h2>
		<p>Argumento al cliente: <em>"tu data confidencial no entrena modelos LLM, no sale del VPS sin scrub, queda registrado en audit log mensual"</em>.</p>

		<table>
			<thead><tr><th>Capa</th><th>Qué hace</th></tr></thead>
			<tbody>
				<tr><td><strong>1. Scrub pre-LLM</strong></td><td>RFCs, montos, emails reemplazados con placeholders <code>[CLIENT-X]</code></td></tr>
				<tr><td><strong>2. Anthropic no entrena</strong></td><td>Setting "Help improve Claude" OFF en Max sub</td></tr>
				<tr><td><strong>3. Audit log inmutable</strong></td><td>Cada egress en <code>aria_llm_egress_log</code> · <a href="/dashboard/audit/egress">Audit dashboard</a></td></tr>
				<tr><td><strong>4. Confidential nunca sale</strong></td><td>Channel router fuerza <code>gemma-local</code> (Ollama VPS)</td></tr>
			</tbody>
		</table>

		<h3>Sensitivity tags</h3>
		<table>
			<thead><tr><th>Tag</th><th>A dónde puede salir</th><th>Cuándo se usa</th></tr></thead>
			<tbody>
				<tr><td><code>public</code></td><td>Cualquier LLM</td><td>Info abierta</td></tr>
				<tr><td><code>internal</code></td><td>Claude Max VPS o Anthropic API</td><td>Workflows del equipo</td></tr>
				<tr><td><code>client</code></td><td>Solo con scrub a tokens</td><td>Auto-inferido si scope=client_knowledge</td></tr>
				<tr><td><code>confidential</code></td><td><strong>Solo Gemma local</strong></td><td>RFCs, credenciales</td></tr>
			</tbody>
		</table>

		<h2 id="cuenta">12. Mi cuenta · perfil · seguridad</h2>
		<table>
			<thead><tr><th>Tab</th><th>URL</th><th>Qué hacés</th></tr></thead>
			<tbody>
				<tr><td>📊 Mi actividad</td><td><a href="/dashboard/me">/me</a></td><td>Stats, heatmap 365d, timeline, tareas, contribuciones</td></tr>
				<tr><td>👤 Perfil</td><td><a href="/dashboard/me/profile">/me/profile</a></td><td>Nombre, título, teléfono, timezone, idioma, bio, avatar</td></tr>
				<tr><td>🔒 Seguridad</td><td><a href="/dashboard/me/security">/me/security</a></td><td>Cambiar contraseña (verifica current vía bcrypt)</td></tr>
				<tr><td>🔔 Notificaciones</td><td><a href="/dashboard/me/notifications">/me/notifications</a></td><td>Toggles: mentions, quotes, share links, weekly digest, zombies</td></tr>
			</tbody>
		</table>
		<p>Forgot password: en login link "¿Olvidaste tu contraseña?". Anti-enumeration: el sistema NO confirma si el email existe.</p>

		<h2 id="roles">13. Roles y permisos</h2>
		<p>5 roles soportados. Un usuario puede tener varios.</p>
		<table>
			<thead><tr><th>Role</th><th>Crea/borra users</th><th>Cotizador</th><th>Vault admin</th><th>Projects</th><th>Memoria</th></tr></thead>
			<tbody>
				<tr><td><span class="role-badge role-admin">admin</span></td><td>✓</td><td>✓</td><td>✓</td><td>✓</td><td>✓</td></tr>
				<tr><td><span class="role-badge role-agent">agent</span></td><td>✗</td><td>✓</td><td>read</td><td>✓</td><td>✓ + cross-personal read</td></tr>
				<tr><td><span class="role-badge role-cotizador">cotizador</span></td><td>✗</td><td>✓</td><td>read</td><td>✗</td><td>✓</td></tr>
				<tr><td><span class="role-badge role-project_admin">project_admin</span></td><td>✗</td><td>✗</td><td>scope project</td><td>✓ (asignados)</td><td>✓</td></tr>
				<tr><td><span class="role-badge role-dev">dev</span></td><td>✗</td><td>✗</td><td>scope personal</td><td>member</td><td>✓</td></tr>
			</tbody>
		</table>
		<p>El rol <strong>agent</strong> es para asistentes IA (ej. Z.A.R.A.). Tiene admin powers excepto user CRUD (anti privilege escalation). Lee scope=personal de otros users.</p>

		<h2 id="cli">14. Comandos CLI útiles</h2>

		<h4>Auth</h4>
		<pre><code>aria-core login                              # JWT 8h
aria-core whoami
aria-core logout</code></pre>

		<h4>MCP</h4>
		<pre><code>aria-core mcp --profile=aria                 # cloud-bound
aria-core mcp --profile=cotizador
aria-core mcp --tools=agent                  # mem_* engram-style local</code></pre>

		<h4>Memoria</h4>
		<pre><code>aria-core save "título" "contenido" --type decision --project X
aria-core search "query" --project X
aria-core sync --cloud</code></pre>

		<h4>Vault</h4>
		<pre><code>aria-core vault list
aria-core vault create --name X --category api_token --value-from-stdin
aria-core vault get NAME --reason "razón"
aria-core vault rotate NAME --value-from-stdin
aria-core vault scan ./file</code></pre>

		<h4>Recipes</h4>
		<pre><code>aria-core recipe list
aria-core recipe run deploy-aria-core --var branch=main
aria-core recipe history --days=30</code></pre>

		<h4>Cotizador + DOCX</h4>
		<pre><code>aria-core cotizador chat list [--lead=ID]
aria-core cotizador chat show SESSION_ID
aria-core cotizador chat send SESSION_ID --message "..."
aria-core quote export-docx QUOTE_ID --output ./propuesta.docx</code></pre>

		<h4>Project mgmt (wave 7)</h4>
		<pre><code>aria-core projects list
aria-core projects create --name "Foo" [--no-github]
aria-core projects add-member --project SLUG --email user@itechdev.com.mx --role member
aria-core tasks list [--assignee=UID] [--status=todo]
aria-core tasks create --project SLUG --title "..." --assignee UID
aria-core tasks status TASK_ID in_progress
aria-core tasks close TASK_ID</code></pre>

		<h4>Knowledge base (wave 8)</h4>
		<pre><code>aria-core kb status
aria-core kb sync [--project=SLUG]
aria-core kb pull</code></pre>

		<h4>Pages (mini-Notion)</h4>
		<pre><code>aria-core pages list
aria-core pages create --title="Mi PRD" --template=prd-v1 --by-uid &lt;UUID&gt;
aria-core pages attach FILE PAGE_ID
aria-core pages share PAGE_ID --expires=24h</code></pre>

		<h4>Hooks (auto-capture pasivo)</h4>
		<pre><code>aria-core hooks install                      # git hooks en repo actual
aria-core hooks install --global             # hooks globales</code></pre>

		<h4>Admin</h4>
		<pre><code>aria-core admin create-user --email X --name Y --role dev --password Z
aria-core admin list-users
aria-core admin grant-role --uid X --role agent
aria-core admin import-proposals             # carga propuestas históricas</code></pre>

		<h2 id="faq">15. Preguntas frecuentes</h2>

		<h4>¿Cuánto dura mi sesión?</h4>
		<p>JWT 8 horas. Si expira, <code>aria-core login</code>. Si Claude empieza a fallar tools, suele ser eso.</p>

		<h4>¿Puedo usar Claude Max para cotizar sin gastar mi cuota?</h4>
		<p>Sí. El channel <code>claude-max-vps</code> usa la Max sub del VPS. En quote-chat el costo en tu cuota es $0.</p>

		<h4>¿Mi memoria personal la ve el equipo?</h4>
		<p>Si guardás con <code>scope=personal</code> queda solo para vos (excepto agent role). <code>scope=team</code> sí lo ven todos.</p>

		<h4>¿Olvidé mi password admin, qué hago?</h4>
		<p>Pedile a otro admin que la resetee con <code>aria-core admin change-password --uid X</code>, o usá el flow <a href="/dashboard/forgot-password">forgot-password</a>.</p>

		<h4>¿Cómo apago el legacy aria-global?</h4>
		<p>Cuando confirmes que aria-core anda OK: <code>ssh root@VPS && systemctl stop aria-global && systemctl disable aria-global</code>.</p>

		<h4>¿Hay logs?</h4>
		<p>VPS: <code>journalctl -u aria-core -f</code>. Cliente: stdout del binario.</p>

		<h4>¿ARIA Core funciona si no tengo M365 / vault / gotenberg?</h4>
		<p>Sí, todos los módulos degradan gracefully. Email: si M365 vars vacías, no envía pero sigue. Vault: modo "metadata-only" si master key vacío. PDF: 503 si gotenberg no corre. <strong>El core (memoria + cotizador + dashboard) siempre anda.</strong></p>

		<h4>¿Cómo participan otros agentes IA aparte de Claude?</h4>
		<p>Z.A.R.A. (Hermes agent de JC) usa role=agent + MCP stdio. Para sumar otro: crear user con role=agent, configurar runtime con spawn del binario MCP.</p>

		<h4>¿Qué pasa con la data del cliente cuando cancelan el contrato?</h4>
		<p>Right-to-be-forgotten: comando admin que purga todo lo de un client_id con cascade audit. Compliance dashboard exporta reporte mensual de qué se guardó/envió.</p>

		<h4>¿Cómo se actualiza ARIA Core?</h4>
		<p>Deploy continuo desde <code>main</code>. Backups Postgres nightly a 03:00 UTC con retención 30d.</p>

		<h2>Recursos</h2>
		<ul>
			<li>Repo: <a href="https://github.com/ITECHDEV-MX/aria-core">github.com/ITECHDEV-MX/aria-core</a></li>
			<li>Knowledge base: <a href="https://github.com/ITECHDEV-MX/team-knowledge-base">github.com/ITECHDEV-MX/team-knowledge-base</a></li>
			<li>Dashboard: <a href="https://ariacore.itechdev.com.mx">ariacore.itechdev.com.mx</a></li>
			<li>Mi actividad: <a href="/dashboard/me">/dashboard/me</a></li>
		</ul>

		<p style="margin-top: 3rem; padding: 1rem; background: var(--muted); border-radius: var(--radius-md); text-align: center;" class="muted">
			ARIA Core v2026.04 (wave 8) · iTechDev · Memoria, knowledge y entregables del equipo
			if rolesContains(roles, "admin") {
				<br/>Admin: <a href="/dashboard/admin">Panel admin</a> · <a href="/dashboard/audit/egress">Audit egress</a> · <a href="/dashboard/vault">Vault</a> · <a href="/dashboard/roi">ROI</a>
			}
		</p>
	</section>
}

// rolesContains check helper para mostrar links contextuales en footer.
func rolesContains(roles []string, want string) bool {
	for _, r := range roles {
		if strings.EqualFold(r, want) {
			return true
		}
	}
	return false
}

// ayudaMCPConfig retorna el JSON de ejemplo MCP config como string.
// (Está fuera del .templ para evitar conflictos de parsing con las llaves).
func ayudaMCPConfig() string {
	return `{
  "mcpServers": {
    "aria": {
      "command": "/usr/local/bin/aria-core",
      "args": ["mcp", "--profile=aria"]
    }
  }
}`
}
