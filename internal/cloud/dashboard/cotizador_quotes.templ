package dashboard

import (
	"fmt"
	"strconv"
)

// CotizadorLeadDetailFull — vista completa del lead: info + RFPs + Quotes + history.
templ CotizadorLeadDetailFull(l *CotizadorLeadView, history []CotizadorLeadHistoryView, rfps []CotizadorRFPView, quotes []CotizadorQuoteView) {
	<section class="frame-section">
		<div class="section-header">
			<div>
				<p class="section-kicker">LEAD</p>
				<h2>{ l.Name }</h2>
				<p class="muted">{ l.Company } · estado: <strong>{ cotizadorStatusLabel(l.Status) }</strong></p>
			</div>
			<div>
				<a href="/dashboard/cotizador" class="shell-button">← Volver</a>
			</div>
		</div>

		<h3 class="section-block-title">Editar datos</h3>
		<form hx-post={ "/dashboard/cotizador/leads/" + l.ID + "/update" } hx-target="closest section" hx-swap="outerHTML" class="login-form" style="max-width:680px">
			<label>Nombre <input type="text" name="name" value={ l.Name } required/></label>
			<label>Empresa <input type="text" name="company" value={ l.Company }/></label>
			<label>Email <input type="email" name="email" value={ l.Email }/></label>
			<label>Teléfono <input type="text" name="phone" value={ l.Phone }/></label>
			<label>Origen <input type="text" name="source" value={ l.Source }/></label>
			<label>Notas <textarea name="notes" rows="4">{ l.Notes }</textarea></label>
			<button type="submit" class="shell-button">Guardar cambios</button>
		</form>

		<h3 class="section-block-title">Cambiar estado</h3>
		<form hx-post={ "/dashboard/cotizador/leads/" + l.ID + "/status" } hx-target="closest section" hx-swap="outerHTML" class="login-form" style="max-width:680px">
			<label>
				Nuevo estado
				<select name="status">
					for _, st := range cotizadorLeadStatuses() {
						<option value={ st.Value } selected?={ st.Value == l.Status }>{ st.Label }</option>
					}
				</select>
			</label>
			<label>Notas del cambio <textarea name="notes" rows="2"></textarea></label>
			<button type="submit" class="shell-button">Cambiar estado</button>
		</form>

		<h3 class="section-block-title">RFPs ({ strconv.Itoa(len(rfps)) })</h3>
		<form hx-post={ "/dashboard/cotizador/leads/" + l.ID + "/rfps/create" } hx-target="closest section" hx-swap="outerHTML" class="login-form" style="max-width:680px">
			<label>
				Tipo
				<select name="source_type">
					<option value="text">Texto pegado</option>
					<option value="url">URL</option>
					<option value="pdf">PDF (referencia)</option>
				</select>
			</label>
			<label>Contenido del RFP <textarea name="source_content" rows="6" placeholder="Pegá el RFP completo del cliente acá"></textarea></label>
			<button type="submit" class="shell-button">Guardar RFP</button>
		</form>
		if len(rfps) > 0 {
			<table class="data-table">
				<thead><tr><th>Tipo</th><th>Vista previa</th><th>Creado</th><th>Acción</th></tr></thead>
				<tbody>
					for _, r := range rfps {
						<tr>
							<td>{ r.SourceType }</td>
							<td>{ truncateString(r.SourceContent, 80) }</td>
							<td>{ formatTimestampTime(r.CreatedAt) }</td>
							<td><a href={ templ.SafeURL("/dashboard/cotizador/rfps/" + r.ID) } class="shell-button">Abrir</a></td>
						</tr>
					}
				</tbody>
			</table>
		}

		<h3 class="section-block-title">Cotizaciones ({ strconv.Itoa(len(quotes)) })</h3>
		<a href={ templ.SafeURL("/dashboard/cotizador/leads/" + l.ID + "/quotes/new") } class="shell-button">+ Nueva cotización</a>
		if len(quotes) > 0 {
			<table class="data-table" style="margin-top:0.5rem">
				<thead><tr><th>Versión</th><th>Estado</th><th>Total</th><th>Válida hasta</th><th>Creada</th><th>Acción</th></tr></thead>
				<tbody>
					for _, q := range quotes {
						<tr>
							<td>v{ strconv.Itoa(q.Version) }</td>
							<td><span class={ "badge badge-" + cotizadorQuoteStatusVariant(q.Status) }>{ cotizadorQuoteStatusLabel(q.Status) }</span></td>
							<td>{ formatMoney(q.Total, q.Currency) }</td>
							<td>{ formatDateOrDash(q.ValidUntil) }</td>
							<td>{ formatTimestampTime(q.CreatedAt) }</td>
							<td><a href={ templ.SafeURL("/dashboard/cotizador/quotes/" + q.ID) } class="shell-button">Abrir</a></td>
						</tr>
					}
				</tbody>
			</table>
		}

		<h3 class="section-block-title">Historial del lead</h3>
		if len(history) == 0 {
			<p class="muted">Sin historial.</p>
		} else {
			<table class="data-table">
				<thead><tr><th>Fecha</th><th>Acción</th><th>De</th><th>A</th><th>Notas</th></tr></thead>
				<tbody>
					for _, e := range history {
						<tr>
							<td>{ formatTimestampTime(e.OccurredAt) }</td>
							<td>{ e.Action }</td>
							<td>{ e.FromStatus }</td>
							<td>{ e.ToStatus }</td>
							<td>{ e.Notes }</td>
						</tr>
					}
				</tbody>
			</table>
		}
	</section>
}

// CotizadorRFPDetail — vista de un RFP con editor de análisis.
templ CotizadorRFPDetail(rfp *CotizadorRFPView) {
	<section class="frame-section">
		<div class="section-header">
			<div>
				<p class="section-kicker">RFP</p>
				<h2>RFP { rfp.ID[:8] }...</h2>
				<p class="muted">Tipo: { rfp.SourceType } · creado { formatTimestampTime(rfp.CreatedAt) }</p>
			</div>
			<div>
				<a href={ templ.SafeURL("/dashboard/cotizador/leads/" + rfp.LeadID) } class="shell-button">← Lead</a>
			</div>
		</div>

		<h3 class="section-block-title">Contenido</h3>
		<pre style="white-space:pre-wrap;background:#0a0a0a;padding:1rem;border-radius:4px;max-height:400px;overflow:auto">{ rfp.SourceContent }</pre>

		<h3 class="section-block-title">Análisis (JSON)</h3>
		<p class="muted">Editá el JSON con tu análisis del RFP. Estructura libre por ahora — desde Claude Desktop con MCP, podrás llamar tools que estructuren esto automáticamente.</p>
		<form hx-post={ "/dashboard/cotizador/rfps/" + rfp.ID + "/analysis" } hx-target="closest section" hx-swap="outerHTML" class="login-form">
			<label>
				analysis_json
				<textarea name="analysis_json" rows="20" style="font-family:monospace;font-size:0.85rem">{ rfp.AnalysisJSON }</textarea>
			</label>
			<button type="submit" class="shell-button">Guardar análisis</button>
		</form>
	</section>
}

// CotizadorQuoteNewForm — form de creación de cotización con items dinámicos.
templ CotizadorQuoteNewForm(lead *CotizadorLeadView, rfps []CotizadorRFPView) {
	<section class="frame-section">
		<div class="section-header">
			<div>
				<p class="section-kicker">NUEVA COTIZACIÓN</p>
				<h2>{ lead.Name } — { lead.Company }</h2>
			</div>
			<div>
				<a href={ templ.SafeURL("/dashboard/cotizador/leads/" + lead.ID) } class="shell-button">← Volver</a>
			</div>
		</div>

		<form method="post" action={ templ.SafeURL("/dashboard/cotizador/leads/" + lead.ID + "/quotes/create") } class="login-form">
			<label>
				RFP (opcional)
				<select name="rfp_id">
					<option value="">— sin RFP asociado —</option>
					for _, r := range rfps {
						<option value={ r.ID }>{ r.ID[:8] }... ({ r.SourceType }, { formatTimestampTime(r.CreatedAt) })</option>
					}
				</select>
			</label>
			<label>Moneda <input type="text" name="currency" value="MXN" required/></label>
			<label>Válida hasta <input type="date" name="valid_until"/></label>
			<label>Términos <textarea name="terms" rows="3" placeholder="Forma de pago, vigencia, condiciones..."></textarea></label>
			<label>Justificación / contexto <textarea name="justification" rows="3" placeholder="Por qué este precio, qué incluye, qué supuestos..."></textarea></label>

			<h3 class="section-block-title">Items</h3>
			<div id="quote-items">
				@quoteItemRow(0)
				@quoteItemRow(1)
				@quoteItemRow(2)
			</div>
			<button type="button" class="shell-button" onclick="addQuoteItemRow()">+ Agregar item</button>

			<button type="submit" class="shell-button" style="margin-top:1rem">Crear cotización (status=draft)</button>
		</form>

		<script>
			function addQuoteItemRow() {
				const container = document.getElementById('quote-items');
				const idx = container.children.length;
				const div = document.createElement('div');
				div.style.cssText = 'display:grid;grid-template-columns:1fr 3fr 1fr 1.5fr;gap:8px;margin-bottom:8px';
				div.innerHTML = `
					<input type="text" name="item_sku" placeholder="SKU"/>
					<input type="text" name="item_description" placeholder="Descripción"/>
					<input type="number" name="item_qty" placeholder="Cant" step="0.001" value="1"/>
					<input type="number" name="item_unit_price" placeholder="Precio unitario" step="0.01" value="0"/>
				`;
				container.appendChild(div);
			}
		</script>
	</section>
}

templ quoteItemRow(idx int) {
	<div style="display:grid;grid-template-columns:1fr 3fr 1fr 1.5fr;gap:8px;margin-bottom:8px">
		<input type="text" name="item_sku" placeholder="SKU"/>
		<input type="text" name="item_description" placeholder="Descripción"/>
		<input type="number" name="item_qty" placeholder="Cant" step="0.001" value="1"/>
		<input type="number" name="item_unit_price" placeholder="Precio unitario" step="0.01" value="0"/>
	</div>
}

// CotizadorQuoteDetail — vista detallada de una quote con items + status + history.
templ CotizadorQuoteDetail(q *CotizadorQuoteView, items []CotizadorQuoteItemView, history []CotizadorQuoteHistoryView) {
	<section class="frame-section">
		<div class="section-header">
			<div>
				<p class="section-kicker">COTIZACIÓN v{ strconv.Itoa(q.Version) }</p>
				<h2>{ formatMoney(q.Total, q.Currency) }</h2>
				<p class="muted">Estado: <span class={ "badge badge-" + cotizadorQuoteStatusVariant(q.Status) }>{ cotizadorQuoteStatusLabel(q.Status) }</span></p>
			</div>
			<div>
				<a href={ templ.SafeURL("/dashboard/cotizador/leads/" + q.LeadID) } class="shell-button">← Lead</a>
				<a href={ templ.SafeURL("/dashboard/cotizador/quotes/" + q.ID + "/proposal") } class="shell-button">📄 Vista propuesta</a>
				<a href={ templ.SafeURL("/dashboard/cotizador/quotes/" + q.ID + "/edit-header") } class="shell-button">✏️ Editar propuesta</a>
			</div>
		</div>

		<h3 class="section-block-title">Items</h3>
		<table class="data-table">
			<thead><tr><th>SKU</th><th>Descripción</th><th>Cant</th><th>Precio unitario</th><th>Subtotal</th></tr></thead>
			<tbody>
				for _, it := range items {
					<tr>
						<td>{ it.SKU }</td>
						<td>{ it.Description }</td>
						<td>{ formatFloat(it.Qty, 3) }</td>
						<td>{ formatMoney(it.UnitPrice, q.Currency) }</td>
						<td>{ formatMoney(it.Subtotal, q.Currency) }</td>
					</tr>
				}
				<tr style="font-weight:bold">
					<td colspan="4" style="text-align:right">Subtotal</td>
					<td>{ formatMoney(q.Subtotal, q.Currency) }</td>
				</tr>
				<tr style="font-weight:bold">
					<td colspan="4" style="text-align:right">Total</td>
					<td>{ formatMoney(q.Total, q.Currency) }</td>
				</tr>
			</tbody>
		</table>

		if q.Justification != "" {
			<h3 class="section-block-title">Justificación</h3>
			<p>{ q.Justification }</p>
		}
		if q.Terms != "" {
			<h3 class="section-block-title">Términos</h3>
			<p>{ q.Terms }</p>
		}

		<h3 class="section-block-title">Cambiar estado</h3>
		<form hx-post={ "/dashboard/cotizador/quotes/" + q.ID + "/status" } hx-target="closest section" hx-swap="outerHTML" class="login-form" style="max-width:680px">
			<label>
				Nuevo estado
				<select name="status">
					for _, st := range cotizadorQuoteStatusOptions() {
						<option value={ st.Value } selected?={ st.Value == q.Status }>{ st.Label }</option>
					}
				</select>
			</label>
			<label>Notas del cambio <textarea name="notes" rows="2"></textarea></label>
			<button type="submit" class="shell-button">Cambiar estado</button>
		</form>

		<h3 class="section-block-title">Historial</h3>
		if len(history) == 0 {
			<p class="muted">Sin historial.</p>
		} else {
			<table class="data-table">
				<thead><tr><th>Fecha</th><th>Acción</th><th>De</th><th>A</th><th>Notas</th></tr></thead>
				<tbody>
					for _, e := range history {
						<tr>
							<td>{ formatTimestampTime(e.OccurredAt) }</td>
							<td>{ e.Action }</td>
							<td>{ e.FromStatus }</td>
							<td>{ e.ToStatus }</td>
							<td>{ e.Notes }</td>
						</tr>
					}
				</tbody>
			</table>
		}
	</section>
}

// === helpers exclusivos del módulo ===

templ quotePlaceholder() {
	{ "" }
}

// formatFloat formatea un float64 con N decimales.
func formatFloat(v float64, dec int) string {
	return strconv.FormatFloat(v, 'f', dec, 64)
}

// formatMoney formatea con currency.
func formatMoney(v float64, currency string) string {
	if currency == "" {
		currency = "MXN"
	}
	return fmt.Sprintf("%s %s", strconv.FormatFloat(v, 'f', 2, 64), currency)
}
