package dashboard

// Layout — shell con sidebar + branding iTechDev. Identidad nueva.
templ Layout(title string, username string, activeTab string, roles []string, content templ.Component) {
	<!DOCTYPE html>
	<html lang="es" data-theme="dark">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } — ARIA Core</title>
			<link rel="stylesheet" href="/dashboard/static/aria-styles.css"/>
			<script src="/dashboard/static/htmx.min.js"></script>
			<script>
				// Theme persistence
				(function() {
					const saved = localStorage.getItem('aria-theme') || 'dark';
					document.documentElement.setAttribute('data-theme', saved);
				})();
				function toggleTheme() {
					const cur = document.documentElement.getAttribute('data-theme');
					const next = cur === 'dark' ? 'light' : 'dark';
					document.documentElement.setAttribute('data-theme', next);
					localStorage.setItem('aria-theme', next);
				}
			</script>
		</head>
		<body>
			<div class="app-shell">
				<aside class="sidebar">
					<div class="sidebar-brand">
						<img src="/dashboard/static/img/itechdev-logo.svg" alt="iTechDev" class="sidebar-brand-logo"/>
						<div class="sidebar-brand-text">
							<span class="sidebar-brand-name">ARIA CORE</span>
							<span class="sidebar-brand-sub">iTechDev</span>
						</div>
					</div>
					<nav class="sidebar-nav">
						@SidebarLink("/dashboard/", "🏠", "Inicio", "dashboard", activeTab)
						@SidebarLink("/dashboard/me", "🎯", "Mi actividad", "me", activeTab)
						@SidebarLink("/dashboard/ayuda", "📖", "Guía", "ayuda", activeTab)

						<div class="sidebar-nav-section">Conocimiento</div>
						@SidebarLink("/dashboard/memorias", "💡", "Memoria", "memorias", activeTab)
						if hasAnyRole(roles, "admin", "dev") {
							@SidebarLink("/dashboard/browser", "🔄", "Sync", "browser", activeTab)
						}

						if hasAnyRole(roles, "admin", "dev", "project_admin") {
							<div class="sidebar-nav-section">Operación</div>
							@SidebarLink("/dashboard/projects", "📁", "Proyectos", "projects", activeTab)
						}

						if hasAnyRole(roles, "admin", "cotizador") {
							<div class="sidebar-nav-section">Comercial</div>
							@SidebarLink("/dashboard/cotizador", "💼", "Cotizaciones", "cotizador", activeTab)
						}

						<div class="sidebar-nav-section">ROI</div>
						@SidebarLink("/dashboard/roi", "📈", "ROI & Ahorro", "roi", activeTab)

						if hasAnyRole(roles, "admin") {
							<div class="sidebar-nav-section">Administración</div>
							@SidebarLink("/dashboard/contributors", "👥", "Colaboradores", "contributors", activeTab)
							@SidebarLink("/dashboard/admin/skills", "🎯", "Skills", "admin-skills", activeTab)
							@SidebarLink("/dashboard/audit/egress", "🛡️", "Egress LLM", "audit-egress", activeTab)
							@SidebarLink("/dashboard/admin", "⚙️", "Admin", "admin", activeTab)
						}
					</nav>
					<div class="sidebar-footer">
						<div class="user-card">
							<div class="user-avatar">{ avatarInitial(username) }</div>
							<div class="user-info">
								<div class="user-name">{ username }</div>
								<div class="user-roles">{ rolesShort(roles) }</div>
							</div>
						</div>
						<div style="display:flex;gap:0.5rem;align-items:center">
							<button class="theme-toggle" onclick="toggleTheme()" title="Cambiar tema">🌓</button>
							<form method="post" action="/dashboard/logout" style="margin:0;flex:1">
								<button type="submit" class="shell-button" style="width:100%">Salir</button>
							</form>
						</div>
					</div>
				</aside>
				<main class="main">
					@content
				</main>
			</div>
			<div id="aria-toast-container" class="toast-container" hx-swap-oob="beforeend"></div>
			<script>
				// Auto-dismiss toasts after 4s
				document.addEventListener('htmx:afterSwap', function(e) {
					document.querySelectorAll('.toast:not([data-dismissed])').forEach(function(t) {
						t.setAttribute('data-dismissed', '1');
						setTimeout(function() {
							t.classList.add('toast-leaving');
							setTimeout(function() { t.remove(); }, 200);
						}, 4000);
					});
				});
			</script>
		</body>
	</html>
}

// Toast — notificación efímera (auto-dismiss 4s vía JS en layout).
// Variants: success | error | info. Usar con hx-swap-oob para inyectar
// desde cualquier handler sin cambiar el target principal.
templ Toast(message, variant string) {
	<div class={ "toast", "toast-" + variant }>
		<span class="toast-icon">
			if variant == "success" {
				✓
			} else if variant == "error" {
				⚠
			} else {
				ℹ
			}
		</span>
		<span class="toast-message">{ message }</span>
	</div>
}

// ToastOOB — wrapper que inyecta un toast en el contenedor global vía HTMX OOB.
// Usar al final de la response: @ToastOOB("Lead creado", "success")
templ ToastOOB(message, variant string) {
	<div id="aria-toast-container" class="toast-container" hx-swap-oob="beforeend">
		@Toast(message, variant)
	</div>
}

// SidebarLink — link del nav lateral con icono y estado activo.
templ SidebarLink(href, icon, label, tabID, activeTab string) {
	if tabID == activeTab {
		<a href={ templ.SafeURL(href) } class="active">
			<span class="sidebar-nav-icon">{ icon }</span>
			<span>{ label }</span>
		</a>
	} else {
		<a href={ templ.SafeURL(href) }>
			<span class="sidebar-nav-icon">{ icon }</span>
			<span>{ label }</span>
		</a>
	}
}
